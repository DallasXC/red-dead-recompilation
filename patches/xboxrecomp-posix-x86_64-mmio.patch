+                    write_masked(s_const[d->oaddr], src, d->omask), s_const_gen++;
+            } else if (d->oaddr == 0) {
+                write_masked(opos.v, src, d->omask);
+            } else if (d->oaddr < 13) {
+                write_masked(outregs[d->oaddr], src, d->omask);
+            }
+        }
+        if (d->final) {
+            int k;
+            memcpy(out->pos, opos.v, sizeof out->pos);
+            for (k = 0; k < 4; k++) {
+                float c0 = outregs[3][k], c1 = outregs[4][k];
+                out->d0[k] = c0 > 1.0f ? 1.0f : (c0 >= 0.0f ? c0 : 0.0f);
+                out->d1[k] = c1 > 1.0f ? 1.0f : (c1 >= 0.0f ? c1 : 0.0f);
+            }
+            memcpy(out->fog, outregs[5], sizeof out->fog);
+            memcpy(out->tex[0], outregs[9], sizeof out->tex[0]);
+            memcpy(out->tex[1], outregs[10], sizeof out->tex[1]);
+            memcpy(out->tex[2], outregs[11], sizeof out->tex[2]);
+            memcpy(out->tex[3], outregs[12], sizeof out->tex[3]);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* ---- block execution ----------------------------------------------------
+ *
+ * The same decoded program over up to NV2A_VSH_BLOCK vertices at once,
+ * instruction by instruction: every register is a row of lanes, so the
+ * per-instruction work (picking sources, the op, the masks) is paid once
+ * per block instead of once per vertex, and the inner loops are plain
+ * float arithmetic over the lanes that the compiler vectorises. Results are
+ * the same as vsh_run_fast, lane by lane (a0 is per lane; a program that
+ * writes c[] falls back to it, the write order mattering there).
+ * RECOMP_VSH_BLOCK=0 turns it off. */
+typedef struct { float c[4][NV2A_VSH_BLOCK]; } VshLanes;
+
+static uint32_t s_used_inputs;              /* v0..v15 the program reads */
+static uint32_t s_temps_read;               /* R0..R11 (bit 12: oPos) read */
+static uint32_t s_outs_written;             /* o[1..12] written */
+static int s_block_ok;                      /* no c[] writes */
+
+static void block_prepare_info(void)
+{
+    uint32_t s, used = 0, tr = 0, ow = 0;
+    int ok = 1, k;
+    for (s = 0; s < s_dec_n; s++) {
+        const VshIns *d = &s_dec[s];
+        for (k = 0; k < 3; k++) {
+            if (d->src[k].mux == 2)
+                used |= 1u << d->src[k].in;
+            else if (d->src[k].mux == 1)
+                tr |= 1u << (d->src[k].reg <= 12 ? d->src[k].reg : 0);
+        }
+        if (d->omask && d->out_c)
+            ok = 0;
+        if (d->omask && !d->out_c && d->oaddr > 0 && d->oaddr < 13)
+            ow |= 1u << d->oaddr;
+    }
+    s_used_inputs = used;
+    s_temps_read = tr;
+    s_outs_written = ow;
+    s_block_ok = ok;
+}
+
+uint32_t nv2a_vsh_inputs_used(void)
+{
+    if (!nv2a_vsh_prepare())
+        return 0xFFFFu;
+    return s_used_inputs;
+}
+
+/* Source k of an instruction for lanes 0..n-1: four component pointers,
+ * into a register's rows when the source is a plain register read, into
+ * `tmp` when it had to be built (a constant, a negation, relative). */
+static void block_src(const VshSrc *o, const VshLanes *in, const VshLanes *temp,
+                      const VshLanes *opos, const int *a0, int n,
+                      VshLanes *tmp, const float *ptr[4])
+{
+    int k, l;
+    if (o->mux == 3) {
+        if (o->rel) {
+            for (l = 0; l < n; l++) {
+                int ci = o->ci + a0[l];
+                const float *p;
+                if (ci < 0 || ci >= NV2A_VSH_CONSTANTS)
+                    ci = 0;
+                p = s_const[ci];
+                for (k = 0; k < 4; k++)
+                    tmp->c[k][l] = p[o->sw[k]];
+            }
+        } else {
+            int ci = o->ci;
+            const float *p;
+            if (ci < 0 || ci >= NV2A_VSH_CONSTANTS)
+                ci = 0;
+            p = s_const[ci];
+            for (k = 0; k < 4; k++) {
+                float v = p[o->sw[k]];
+                for (l = 0; l < n; l++)
+                    tmp->c[k][l] = v;
+            }
+        }
+        for (k = 0; k < 4; k++)
+            ptr[k] = tmp->c[k];
+    } else {
+        const VshLanes *r;
+        if (o->mux == 1)
+            r = o->reg == 12 ? opos : (o->reg < 12 ? &temp[o->reg] : &temp[0]);
+        else
+            r = &in[o->in];
+        for (k = 0; k < 4; k++)
+            ptr[k] = r->c[o->sw[k]];
+    }
+    if (o->neg) {
+        for (k = 0; k < 4; k++) {
+            const float *s = ptr[k];
+            for (l = 0; l < n; l++)
+                tmp->c[k][l] = -s[l];
+            ptr[k] = tmp->c[k];
+        }
+    }
+}
+
+static void block_write(VshLanes *dst, const VshLanes *src, uint32_t mask, int n)
+{
+    if (mask & 8) memcpy(dst->c[0], src->c[0], (size_t)n * 4);
+    if (mask & 4) memcpy(dst->c[1], src->c[1], (size_t)n * 4);
+    if (mask & 2) memcpy(dst->c[2], src->c[2], (size_t)n * 4);
+    if (mask & 1) memcpy(dst->c[3], src->c[3], (size_t)n * 4);
+}
+
+typedef struct {
+    VshLanes in[NV2A_VSH_INPUTS];
+    VshLanes temp[12], opos, outr[13];
+    VshLanes sa, sb, sc, mres, ires;
+    int a0[NV2A_VSH_BLOCK];
