+
+/* ── The same evaluation, decoded once per program ─────────────────────
+ *
+ * rc_eval_ref re-reads every control word for every pixel: the input
+ * mappings and output scales through switches, each stage's constants
+ * through a hashed unpack, all sixteen registers set up. It was the largest
+ * single cost of the software rasteriser (about half of the executor on Red
+ * Dead Revolver's front end, which runs several full-screen combiner passes
+ * a frame). A program is the same for every pixel of a batch, so it is
+ * decoded once into the form below -- kept per thread, keyed on the whole
+ * Nv2aCombiner -- and each pixel only does the arithmetic. The results are
+ * the reference's, operation for operation; RECOMP_RC_CHECK=1 runs both and
+ * counts any pixel where they differ. */
+
+typedef struct {
+    uint8_t reg, alpha, kind;          /* register, .a replicate/select, mapping */
+} RcIn;
+
+typedef struct {
+    RcIn A, B, C, D, aA, aB, aC, aD;
+    float c0[4], c1[4];
+    uint32_t fl, afl;
+    float os, ob, aos, aob;            /* output scale and bias, RGB and alpha */
+    uint8_t dab, dcd, dsum, adab, adcd, adsum;   /* destinations, 0 = none */
+} RcStage;
+
+typedef struct {
+    Nv2aCombiner key;
+    int valid;
+    uint32_t n, flags;
+    int r0a_from_t0;
+    RcStage st[8];
+    int final;
+    float fc0[4], fc1[4];
+    uint32_t fflags;
+    RcIn E, F, A, B, C, D, G;
+} RcCompiled;
+
+static RcIn rc_in(uint32_t byte)
+{
+    RcIn in;
+    in.reg = (uint8_t)(byte & 0xF);
+    in.alpha = (uint8_t)((byte >> 4) & 1);
+    in.kind = (uint8_t)((byte >> 5) & 7);
+    return in;
+}
+
+static void rc_out_map(uint32_t mapping, float *scale, float *bias)
+{
+    /* map_out(x) == (x + bias) * scale, exactly: each case is one of these. */
+    *scale = 1.0f; *bias = 0.0f;
+    switch (mapping) {
+    case 0x08: *bias = -0.5f; break;
+    case 0x10: *scale = 2.0f; break;
+    case 0x18: *bias = -0.5f; *scale = 2.0f; break;
+    case 0x20: *scale = 4.0f; break;
+    case 0x30: *scale = 0.5f; break;
+    default: break;
+    }
+}
+
+static void rc_compile(const Nv2aCombiner *rc, RcCompiled *c)
+{
+    uint32_t s;
+
+    memset(c, 0, sizeof *c);
+    c->key = *rc;
+    c->valid = 1;
+    c->n = rc->control & 0xFF;
+    if (c->n > 8)
+        c->n = 8;
+    c->flags = rc->control >> 8;
+    c->r0a_from_t0 = (rc->stage_program & 0x1F) != 0;
+    for (s = 0; s < c->n; s++) {
+        RcStage *t = &c->st[s];
+        uint32_t icw = rc->color_icw[s], ocw = rc->color_ocw[s];
+        uint32_t aicw = rc->alpha_icw[s], aocw = rc->alpha_ocw[s];
+        t->A = rc_in(icw >> 24); t->B = rc_in(icw >> 16);
+        t->C = rc_in(icw >> 8);  t->D = rc_in(icw);
+        t->aA = rc_in(aicw >> 24); t->aB = rc_in(aicw >> 16);
+        t->aC = rc_in(aicw >> 8);  t->aD = rc_in(aicw);
+        nv2a_rc_unpack(rc->factor0[(c->flags & 0x010) ? s : 0], t->c0);
+        nv2a_rc_unpack(rc->factor1[(c->flags & 0x100) ? s : 0], t->c1);
+        t->fl = ocw >> 12;
+        t->afl = aocw >> 12;
+        rc_out_map(t->fl & 0x38, &t->os, &t->ob);
+        rc_out_map(t->afl & 0x38, &t->aos, &t->aob);
+        t->dab = (uint8_t)((ocw >> 4) & 0xF);
+        t->dcd = (uint8_t)(ocw & 0xF);
+        t->dsum = (uint8_t)((ocw >> 8) & 0xF);
+        t->adab = (uint8_t)((aocw >> 4) & 0xF);
+        t->adcd = (uint8_t)(aocw & 0xF);
+        t->adsum = (uint8_t)((aocw >> 8) & 0xF);
+    }
+    c->final = rc->final0 || rc->final1;
+    if (c->final) {
+        nv2a_rc_unpack(rc->final_c0, c->fc0);
+        nv2a_rc_unpack(rc->final_c1, c->fc1);
+        c->fflags = rc->final1 & 0xFF;
+        c->E = rc_in(rc->final1 >> 24);
+        c->F = rc_in(rc->final1 >> 16);
+        c->G = rc_in(rc->final1 >> 8);
+        c->A = rc_in(rc->final0 >> 24);
+        c->B = rc_in(rc->final0 >> 16);
+        c->C = rc_in(rc->final0 >> 8);
+        c->D = rc_in(rc->final0);
+    }
+}
+
+static inline float rc_map(float x, unsigned kind)
+{
+    float p = x < 0.0f ? 0.0f : x;
+    switch (kind) {
+    case 0:  return p;
+    case 1:  return 1.0f - (x < 0.0f ? 0.0f : (x > 1.0f ? 1.0f : x));
+    case 2:  return 2.0f * p - 1.0f;
+    case 3:  return -2.0f * p + 1.0f;
+    case 4:  return p - 0.5f;
+    case 5:  return -p + 0.5f;
+    case 6:  return x;
+    default: return -x;
+    }
+}
+
+static inline void rc_rgb(float R[16][4], RcIn in, float v[3])
+{
+    const float *r = R[in.reg];
+    if (in.alpha) {
+        float a = rc_map(r[3], in.kind);
+        v[0] = v[1] = v[2] = a;
+    } else {
+        v[0] = rc_map(r[0], in.kind);
+        v[1] = rc_map(r[1], in.kind);
+        v[2] = rc_map(r[2], in.kind);
+    }
+}
+
+static inline float rc_alpha(float R[16][4], RcIn in)
+{
+    const float *r = R[in.reg];
+    return rc_map(in.alpha ? r[3] : r[2], in.kind);
+}
+
+static inline float rc_clamp1(float x)
+{
+    return x < -1.0f ? -1.0f : (x > 1.0f ? 1.0f : x);
+}
+
+static void rc_eval_fast(const Nv2aCombiner *rc, const float v0[4],
+                         const float v1[4], const float fog[4],
+                         const float t[4][4], float out[4])
+{
+    static NV_RC_TLS RcCompiled *cache;
+    static NV_RC_TLS RcCompiled *cache2;   /* the previous program, for A/B batches */
+    RcCompiled *c;
+    float R[16][4];
+    uint32_t s;
+    int i;
+
+    if (!cache) {
+        cache = (RcCompiled *)calloc(1, sizeof *cache);
+        cache2 = (RcCompiled *)calloc(1, sizeof *cache2);
+        if (!cache || !cache2) {
+            rc_eval_ref(rc, v0, v1, fog, t, out);
+            return;
+        }
+    }
+    if (!cache->valid || memcmp(&cache->key, rc, sizeof *rc) != 0) {
+        RcCompiled *sw = cache;
+        cache = cache2;
+        cache2 = sw;
+        if (!cache->valid || memcmp(&cache->key, rc, sizeof *rc) != 0)
+            rc_compile(rc, cache);
+    }
+    c = cache;
+
+    for (i = 0; i < 4; i++) {
+        R[0][i] = R[6][i] = R[7][i] = 0.0f;
+        R[12][i] = R[13][i] = R[14][i] = R[15][i] = 0.0f;
+        R[R_FOG][i] = fog[i];
+        R[R_V0][i] = v0[i];
+        R[R_V1][i] = v1[i];
+        R[R_T0 + 0][i] = t[0][i];
+        R[R_T0 + 1][i] = t[1][i];
+        R[R_T0 + 2][i] = t[2][i];
+        R[R_T0 + 3][i] = t[3][i];
+    }
+    R[R_R0][3] = c->r0a_from_t0 ? t[0][3] : 1.0f;
+
+    for (s = 0; s < c->n; s++) {
+        const RcStage *g = &c->st[s];
+        float A[3], B[3], C[3], D[3], ab[3], cd[3], ms[3];
+        float aA, aB, aC, aD, aab, acd, ams, dab, dcd;
+        uint32_t fl = g->fl, afl = g->afl;
+        int mux_cd;
+
+        memcpy(R[R_C0], g->c0, 16);
+        memcpy(R[R_C1], g->c1, 16);
+        mux_cd = (c->flags & 1) ? R[R_R0][3] >= 0.5f
+                                : ((int)(R[R_R0][3] * 255.0f) & 1);
+
+        rc_rgb(R, g->A, A); rc_rgb(R, g->B, B);
+        rc_rgb(R, g->C, C); rc_rgb(R, g->D, D);
+        aA = rc_alpha(R, g->aA); aB = rc_alpha(R, g->aB);
+        aC = rc_alpha(R, g->aC); aD = rc_alpha(R, g->aD);
+
+        dab = A[0] * B[0] + A[1] * B[1] + A[2] * B[2];
+        dcd = C[0] * D[0] + C[1] * D[1] + C[2] * D[2];
+        for (i = 0; i < 3; i++) {
+            float pab = (fl & 2) ? dab : A[i] * B[i];
+            float pcd = (fl & 1) ? dcd : C[i] * D[i];
+            float sum = (fl & 4) ? (mux_cd ? pcd : pab) : pab + pcd;
+            ab[i] = rc_clamp1((pab + g->ob) * g->os);
+            cd[i] = rc_clamp1((pcd + g->ob) * g->os);
+            ms[i] = rc_clamp1((sum + g->ob) * g->os);
+        }
+        {
+            float pab = aA * aB, pcd = aC * aD;
+            float sum = (afl & 4) ? (mux_cd ? pcd : pab) : pab + pcd;
+            aab = rc_clamp1((pab + g->aob) * g->aos);
+            acd = rc_clamp1((pcd + g->aob) * g->aos);
+            ams = rc_clamp1((sum + g->aob) * g->aos);
+        }
+        if (g->dab) {
+            float *d = R[g->dab];
+            d[0] = ab[0]; d[1] = ab[1]; d[2] = ab[2];
+            if (fl & 0x80) d[3] = ab[2];
+        }
+        if (g->dcd) {
+            float *d = R[g->dcd];
+            d[0] = cd[0]; d[1] = cd[1]; d[2] = cd[2];
+            if (fl & 0x40) d[3] = cd[2];
+        }
+        if (g->dsum) {
+            float *d = R[g->dsum];
+            d[0] = ms[0]; d[1] = ms[1]; d[2] = ms[2];
+        }
+        if (g->adab)  R[g->adab][3] = aab;
+        if (g->adcd)  R[g->adcd][3] = acd;
+        if (g->adsum) R[g->adsum][3] = ams;
+        R[R_ZERO][0] = R[R_ZERO][1] = R[R_ZERO][2] = R[R_ZERO][3] = 0.0f;
+    }
+
+    if (c->final) {
+        float A[3], B[3], C[3], D[3], E[3], F[3];
+        uint32_t fflags = c->fflags;
+
+        memcpy(R[R_C0], c->fc0, 16);
+        memcpy(R[R_C1], c->fc1, 16);
+        for (i = 0; i < 3; i++) {
+            float a = (fflags & 0x40) ? 1.0f - R[R_V1][i] : R[R_V1][i];
+            float b = (fflags & 0x20) ? 1.0f - R[R_R0][i] : R[R_R0][i];
+            R[R_SUM][i] = (fflags & 0x80) ? clampf(a + b, 0.0f, 1.0f) : a + b;
+        }
+        R[R_SUM][3] = 0.0f;
+        rc_rgb(R, c->E, E);
+        rc_rgb(R, c->F, F);
+        for (i = 0; i < 3; i++)
+            R[R_EF][i] = E[i] * F[i];
+        R[R_EF][3] = 0.0f;
+        rc_rgb(R, c->A, A); rc_rgb(R, c->B, B);
+        rc_rgb(R, c->C, C); rc_rgb(R, c->D, D);
+        for (i = 0; i < 3; i++)
+            out[i] = D[i] + C[i] * (1.0f - A[i]) + B[i] * A[i];
+        out[3] = rc_alpha(R, c->G);
+    } else {
+        for (i = 0; i < 4; i++)
+            out[i] = R[R_R0][i];
+    }
+    for (i = 0; i < 4; i++)
+        out[i] = clampf(out[i], 0.0f, 1.0f);
+}
+
+void nv2a_rc_eval(const Nv2aCombiner *rc, const float v0[4],
+                  const float v1[4], const float fog[4],
+                  const float t[4][4], float out[4])
+{
+    static int check = -1;
+
+    if (check < 0) {
+        const char *e = getenv("RECOMP_RC_CHECK");
+        check = e && *e && *e != '0';
+    }
+    rc_eval_fast(rc, v0, v1, fog, t, out);
+    if (check) {
+        static volatile long pixels, diffs;
+        float ref[4];
+        rc_eval_ref(rc, v0, v1, fog, t, ref);
+        pixels++;
+        if ((ref[0] != out[0] || ref[1] != out[1] || ref[2] != out[2]
+             || ref[3] != out[3]) && diffs++ < 20)
+            fprintf(stderr, "[RC-CHECK] differs: fast %g %g %g %g ref %g %g %g %g\n",
+                    out[0], out[1], out[2], out[3], ref[0], ref[1], ref[2], ref[3]);
+        if ((pixels & 0xFFFFF) == 0)
+            fprintf(stderr, "[RC-CHECK] %ld pixels, %ld differ\n", pixels, diffs);
+    }
+}
diff --git a/src/kernel/nv2a_gl.c b/src/kernel/nv2a_gl.c
new file mode 100644
index 0000000..9ba21cc
--- /dev/null
+++ b/src/kernel/nv2a_gl.c
@@ -0,0 +1,3763 @@
+/*
+ * NV2A on the host GPU through OpenGL 3.3. See nv2a_gl.h.
+ *
+ * No GL headers or loader library: the few dozen entry points are declared
+ * here and fetched at run time (wglGetProcAddress / opengl32.dll on Windows,
+ * SDL_GL_GetProcAddress elsewhere), so a build needs nothing beyond what the
+ * toolkit already links.
+ *
+ * Pixel shaders are generated from the register-combiner program, one per
+ * distinct program (control words only -- the per-stage constants are
+ * uniforms), following nv2a_combiner.c operation for operation, which in
+ * turn follows xemu's psh.c.
+ *
+ * Coordinates: surface row 0 is GL row 0, so a surface read back with
+ * glReadPixels lands in guest memory in order and a texture uploaded from
+ * guest memory has its first row at t = 0 -- nothing is flipped anywhere.
+ */
+#include "nv2a_gl.h"
+
+#include <math.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#define GLAPIENTRY __stdcall
+#else
+#include <SDL.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#define GLAPIENTRY
+#endif
+
+extern ptrdiff_t xbox_GetMemoryOffset(void);
+extern uint64_t xbox_HostNowNs(void);
+
+/* ---- GL declarations ------------------------------------------------- */
+
+typedef unsigned int GLenum, GLuint, GLbitfield;
+typedef int GLint, GLsizei;
+typedef float GLfloat;
+typedef double GLdouble;
+typedef unsigned char GLboolean;
+typedef char GLchar;
+typedef ptrdiff_t GLsizeiptr, GLintptr;
+typedef void GLvoid;
+
+#define GL_NO_ERROR                 0
+#define GL_TRIANGLES                0x0004
+#define GL_NEVER                    0x0200
+#define GL_ALWAYS                   0x0207
+#define GL_BLEND                    0x0BE2
