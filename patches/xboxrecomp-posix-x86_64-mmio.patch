+static DWORD WINAPI sdl_start_thread(LPVOID unused)
+{
+    int i, n;
+    DWORD t0 = GetTickCount();
+    (void)unused;
+    /* The game's window is not SDL's: read the pads whatever has focus. */
+    SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+    /* Rumble on PlayStation pads over Bluetooth too. */
+    SDL_SetHint(SDL_HINT_JOYSTICK_HIDAPI_PS4_RUMBLE, "1");
+    SDL_SetHint(SDL_HINT_JOYSTICK_HIDAPI_PS5_RUMBLE, "1");
+    /* Plugging a pad in later: SDL's own thread watches for it (nothing
+     * here pumps window messages for SDL), which also lets this thread end. */
+    SDL_SetHint(SDL_HINT_JOYSTICK_THREAD, "1");
+    sdl_InputInit();
+    if (!SDL_WasInit(SDL_INIT_GAMECONTROLLER)) {
