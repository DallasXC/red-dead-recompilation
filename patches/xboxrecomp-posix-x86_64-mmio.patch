+
+static int env_int(const char *name, int def, int lo, int hi)
+{
+    const char *e = getenv(name);
+    int v;
+    if (!e || !*e)
+        return def;
+    v = atoi(e);
+    return v < lo ? lo : v > hi ? hi : v;
+}
+
+static void options_from_env(void)
+{
+    const char *e;
+    s_opt.render_scale = env_int("RECOMP_RENDER_SCALE", 1, 1, 8);
+    s_opt.aniso = env_int("RECOMP_ANISO", 1, 1, 16);
+    s_opt.fxaa = env_int("RECOMP_FXAA", 0, 0, 1);
+    s_opt.vsync = env_int("RECOMP_VSYNC", 0, 0, 1);
+    s_opt.fps_cap = env_int("RECOMP_FPS_CAP", 0, 0, 1000);
+    e = getenv("RECOMP_PRESENT_FILTER");
+    s_opt.filter = (e && (e[0] == 'n' || e[0] == 'N' || e[0] == 's' || e[0] == 'S')) ? 1 : 0;
+    e = getenv("RECOMP_ASPECT");
+    s_opt.aspect = !e ? 0 : (e[0] == 's' || e[0] == 'S') ? 1 : !strcmp(e, "4:3") ? 2
+                 : !strcmp(e, "16:9") ? 3 : 0;
+    s_rs = s_rs_want = s_opt.render_scale;
+}
+
+static const char *s_pp_vs =
+    "#version 330\n"
+    "uniform vec4 uDst; uniform vec4 uSrc;\n"
+    "out vec2 vUV;\n"
+    "void main() {\n"
+    "  vec2 t = vec2(float(gl_VertexID & 1), float(gl_VertexID >> 1));\n"
+    "  gl_Position = vec4(mix(uDst.xy, uDst.zw, t), 0.0, 1.0);\n"
+    "  vUV = mix(uSrc.xy, uSrc.zw, t);\n"
+    "}\n";
+
+/* FXAA after Timothy Lottes' compact form: one edge search along the local
+ * gradient, kept only when the blend stays inside the neighbourhood's luma
+ * range. It runs in source texels while scaling to the window. */
+static const char *s_pp_fs =
+    "#version 330\n"
+    "uniform sampler2D uTex; uniform vec2 uTexel; uniform int uFxaa;\n"
+    "in vec2 vUV; out vec4 oC;\n"
+    "void main() {\n"
+    "  if (uFxaa == 0) { oC = vec4(texture(uTex, vUV).rgb, 1.0); return; }\n"
+    "  vec3 nw = texture(uTex, vUV + vec2(-0.5, -0.5) * uTexel).rgb;\n"
+    "  vec3 ne = texture(uTex, vUV + vec2( 0.5, -0.5) * uTexel).rgb;\n"
+    "  vec3 sw = texture(uTex, vUV + vec2(-0.5,  0.5) * uTexel).rgb;\n"
+    "  vec3 se = texture(uTex, vUV + vec2( 0.5,  0.5) * uTexel).rgb;\n"
+    "  vec3 m  = texture(uTex, vUV).rgb;\n"
+    "  vec3 L = vec3(0.299, 0.587, 0.114);\n"
+    "  float lnw = dot(nw, L), lne = dot(ne, L), lsw = dot(sw, L), lse = dot(se, L), lm = dot(m, L);\n"
+    "  float lmin = min(lm, min(min(lnw, lne), min(lsw, lse)));\n"
+    "  float lmax = max(lm, max(max(lnw, lne), max(lsw, lse)));\n"
+    "  vec2 dir = vec2(-((lnw + lne) - (lsw + lse)), (lnw + lsw) - (lne + lse));\n"
+    "  float red = max((lnw + lne + lsw + lse) * (0.25 / 8.0), 1.0 / 128.0);\n"
+    "  float rcp = 1.0 / (min(abs(dir.x), abs(dir.y)) + red);\n"
+    "  dir = clamp(dir * rcp, vec2(-8.0), vec2(8.0)) * uTexel;\n"
+    "  vec3 a = 0.5 * (texture(uTex, vUV + dir * (1.0/3.0 - 0.5)).rgb +\n"
+    "                  texture(uTex, vUV + dir * (2.0/3.0 - 0.5)).rgb);\n"
+    "  vec3 b = a * 0.5 + 0.25 * (texture(uTex, vUV - dir * 0.5).rgb +\n"
+    "                             texture(uTex, vUV + dir * 0.5).rgb);\n"
+    "  float lb = dot(b, L);\n"
+    "  oC = vec4((lb < lmin || lb > lmax) ? a : b, 1.0);\n"
+    "}\n";
+
+/* Views (xbox_PresentSetViews): parts of the frame, each shown on its own.
+ * The first goes to the game's window, the others each to a window of its
+ * own -- a split-screen game's players on separate windows or monitors.
+ * Rectangles are fractions of the frame: x0, y0, x1, y1. */
+#define PV_MAX 4
+#if defined(_WIN32)
+extern void *xbox_FramebufferWindowHandle(void);
+#endif
+static volatile int s_pv_n;
+static volatile float s_pv[PV_MAX][4];
+static volatile int s_pv_seq;
+
+/* rects: n x (x0, y0, x1, y1), fractions of the frame; view 0 is the
+ * game's window, the others windows of their own. A rectangle with x1 <=
+ * x0 holds its window: it keeps the picture it has (not the first). */
+void xbox_PresentSetViews(int n, const float *rects)
+{
+    int i, k;
+    if (n < 0) n = 0;
+    if (n > PV_MAX) n = PV_MAX;
+    s_pv_seq++;
+    for (i = 0; i < n; i++)
+        for (k = 0; k < 4; k++)
+            s_pv[i][k] = rects[i * 4 + k];
+    s_pv_n = n;
+    s_pv_seq++;
+}
+
+#if defined(_WIN32)
+/* The extra windows: made on the presenting thread, which also pumps their
+ * messages. Keys and mouse buttons go on to the game's window (the game
+ * reads them there); F11 or a double click makes one fill its monitor;
+ * closing one only hides it until the views change. */
+static struct { HWND hwnd; HDC dc; int hidden, full; RECT was; LONG style; } s_xw[PV_MAX];
+static char s_xw_title[96] = "Player %d";
+
+void xbox_PresentSetViewTitle(const char *fmt)
+{
+    if (fmt && *fmt) {
+        strncpy(s_xw_title, fmt, sizeof s_xw_title - 1);
+        s_xw_title[sizeof s_xw_title - 1] = 0;
+    }
+}
+
+static void xw_fullscreen(int i)
+{
+    HWND h = s_xw[i].hwnd;
+    if (!s_xw[i].full) {
+        MONITORINFO mi;
+        mi.cbSize = sizeof mi;
+        GetWindowRect(h, &s_xw[i].was);
+        s_xw[i].style = GetWindowLongA(h, GWL_STYLE);
+        if (!GetMonitorInfoA(MonitorFromWindow(h, MONITOR_DEFAULTTONEAREST), &mi))
+            return;
+        SetWindowLongA(h, GWL_STYLE, (s_xw[i].style & ~WS_OVERLAPPEDWINDOW) | WS_POPUP);
+        SetWindowPos(h, HWND_TOP, mi.rcMonitor.left, mi.rcMonitor.top, mi.rcMonitor.right - mi.rcMonitor.left,
+                     mi.rcMonitor.bottom - mi.rcMonitor.top, SWP_FRAMECHANGED | SWP_SHOWWINDOW);
+        s_xw[i].full = 1;
+    } else {
+        RECT r = s_xw[i].was;
+        SetWindowLongA(h, GWL_STYLE, s_xw[i].style);
+        SetWindowPos(h, NULL, r.left, r.top, r.right - r.left, r.bottom - r.top,
+                     SWP_FRAMECHANGED | SWP_SHOWWINDOW | SWP_NOZORDER);
+        s_xw[i].full = 0;
+    }
+}
+
+static LRESULT CALLBACK xw_proc(HWND h, UINT msg, WPARAM w, LPARAM l)
+{
+    int i;
+    for (i = 1; i < PV_MAX && s_xw[i].hwnd != h; i++)
+        ;
+    switch (msg) {
+    case WM_CLOSE:
+        if (i < PV_MAX) {
+            ShowWindow(h, SW_HIDE);
+            s_xw[i].hidden = 1;
+        }
+        return 0;
+    case WM_LBUTTONDBLCLK:
+        if (i < PV_MAX)
+            xw_fullscreen(i);
+        return 0;
+    case WM_KEYDOWN:
+    case WM_SYSKEYDOWN:
+        if (w == VK_F11 || (msg == WM_SYSKEYDOWN && w == VK_RETURN)) {
+            if (i < PV_MAX && !(l & (1 << 30)))
+                xw_fullscreen(i);
+            return 0;
+        }
+        /* fall through */
+    case WM_KEYUP:
+    case WM_SYSKEYUP:
+    case WM_CHAR:
+    case WM_LBUTTONDOWN: case WM_LBUTTONUP:
+    case WM_RBUTTONDOWN: case WM_RBUTTONUP:
+    case WM_MBUTTONDOWN: case WM_MBUTTONUP:
+    case WM_MOUSEWHEEL: {
+        HWND game = (HWND)xbox_FramebufferWindowHandle();
+        if (game)
+            PostMessageA(game, msg, w, l);
+        if (msg == WM_SYSKEYDOWN || msg == WM_SYSKEYUP)
+            return 0;               /* (no system menu on Alt) */
+        break;
+    }
+    case WM_SETCURSOR:
+        if (LOWORD(l) == HTCLIENT) {
+            SetCursor(LoadCursor(NULL, IDC_ARROW));
+            return TRUE;
+        }
+        break;
+    }
+    return DefWindowProcA(h, msg, w, l);
+}
+
+/* Window i (1..) made current, its size in *w, *h; 0: not now. */
+static int xw_target(int i, int *w, int *h)
+{
+    static int registered;
+    RECT r;
+    if (!s_xw[i].hwnd) {
+        PIXELFORMATDESCRIPTOR pfd;
+        WNDCLASSA wc;
+        char title[128];
+        int pf;
+        RECT want = { 0, 0, 1280, 720 };
+        if (!registered) {
+            memset(&wc, 0, sizeof wc);
+            wc.style = CS_OWNDC | CS_DBLCLKS;
+            wc.lpfnWndProc = xw_proc;
+            wc.hInstance = GetModuleHandleA(NULL);
+            wc.hCursor = LoadCursor(NULL, IDC_ARROW);
+            wc.hIcon = LoadIconA(GetModuleHandleA(NULL), MAKEINTRESOURCEA(1));
+            wc.lpszClassName = "xboxrecomp_view";
+            RegisterClassA(&wc);
+            registered = 1;
+        }
+        snprintf(title, sizeof title, s_xw_title, i + 1);
+        AdjustWindowRect(&want, WS_OVERLAPPEDWINDOW, FALSE);
+        s_xw[i].hwnd = CreateWindowExA(0, "xboxrecomp_view", title, WS_OVERLAPPEDWINDOW,
+                                       CW_USEDEFAULT, CW_USEDEFAULT, want.right - want.left,
+                                       want.bottom - want.top, NULL, NULL, GetModuleHandleA(NULL), NULL);
+        if (!s_xw[i].hwnd)
+            return 0;
+        s_xw[i].dc = GetDC(s_xw[i].hwnd);
+        memset(&pfd, 0, sizeof pfd);
+        pfd.nSize = sizeof pfd;
+        pfd.nVersion = 1;
+        pfd.dwFlags = PFD_DRAW_TO_WINDOW | PFD_SUPPORT_OPENGL | PFD_DOUBLEBUFFER;
+        pfd.iPixelType = PFD_TYPE_RGBA;
+        pfd.cColorBits = 32;
+        pfd.cDepthBits = 24;
+        pfd.cStencilBits = 8;
+        pf = ChoosePixelFormat(s_xw[i].dc, &pfd);
+        if (!pf || !SetPixelFormat(s_xw[i].dc, pf, &pfd)) {
+            fprintf(stderr, "[GPU-GL] view window %d: no pixel format (error %lu)\n", i + 1,
+                    (unsigned long)GetLastError());
+            ReleaseDC(s_xw[i].hwnd, s_xw[i].dc);
+            DestroyWindow(s_xw[i].hwnd);
+            s_xw[i].hwnd = NULL;
+            s_xw[i].dc = NULL;
+            return 0;
+        }
+        ShowWindow(s_xw[i].hwnd, SW_SHOWNOACTIVATE);
+        s_xw[i].hidden = 0;
+        fprintf(stderr, "[GPU-GL] view %d: a window of its own\n", i + 1);
+        fflush(stderr);
+    }
+    {
+        MSG m;
+        while (PeekMessageA(&m, s_xw[i].hwnd, 0, 0, PM_REMOVE)) {
+            TranslateMessage(&m);
+            DispatchMessageA(&m);
+        }
+    }
+    if (s_xw[i].hidden || IsIconic(s_xw[i].hwnd))
+        return 0;
+    if (!wglMakeCurrent(s_xw[i].dc, s_hglrc))
+        return 0;
+    GetClientRect(s_xw[i].hwnd, &r);
+    *w = r.right - r.left;
+    *h = r.bottom - r.top;
+    p_glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    return *w > 0 && *h > 0;
+}
+
+/* The views ended: the extra windows go away. */
+static void xw_close_from(int first)
+{
+    int i;
+    for (i = first < 1 ? 1 : first; i < PV_MAX; i++)
+        if (s_xw[i].hwnd) {
+            ReleaseDC(s_xw[i].hwnd, s_xw[i].dc);
+            DestroyWindow(s_xw[i].hwnd);
+            s_xw[i].hwnd = NULL;
+            s_xw[i].dc = NULL;
+            s_xw[i].full = 0;
+        }
+}
+#else
+void xbox_PresentSetViewTitle(const char *fmt) { (void)fmt; }
+#endif
