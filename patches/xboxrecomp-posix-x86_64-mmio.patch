+/* The dashboard's video settings, as stored (XGetVideoFlags bits << 16).
+ *
+ * This used to answer 0x3 -- the XGetVideoFlags bits unshifted -- which XAPI
+ * shifts right by 16 to nothing: every title saw a 4:3, 480i set. The stored
+ * form is the flags in the high word.
+ *
+ * RECOMP_WIDESCREEN=1 sets the dashboard's "Widescreen" option. A title that
+ * supports it then renders anamorphic 16:9 into its usual 640x480 frame, and
+ * the presenter stretches that frame to 16:9 (xbox_VideoWidescreen).
+ * RECOMP_480P=1 also offers 480p (a title may switch to a progressive mode;
+ * the picture is the same here). */
+int xbox_VideoWidescreen(void)
+{
+    static int ws = -1;
+    if (ws < 0) {
+        const char *e = getenv("RECOMP_WIDESCREEN");
+        ws = (e && *e && *e != '0') ? 1 : 0;
+    }
+    return ws;
+}
