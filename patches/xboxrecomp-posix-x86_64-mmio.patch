+/* Anisotropic filtering for mipmapped textures (RECOMP_ANISO: 1-16). The
+ * NV2A has it too, but titles of the time rarely asked; it sharpens floors
+ * and roads seen at an angle and costs next to nothing on a modern card. */
+static float s_aniso = 1.0f, s_aniso_max = 1.0f;
+
+static NvGlOptions s_opt;                 /* defined with the presenter */
+static int s_rs = 1, s_rs_want = 1;       /* render scale: see s_surf */
+static void options_from_env(void);
+
+#if defined(_WIN32)
+static HWND  s_hwnd;
+static HDC   s_hdc;
+static HGLRC s_hglrc;
+static HMODULE s_gl32;
+
+static void *gl_proc(const char *name)
+{
+    void *p = (void *)wglGetProcAddress(name);
+    if (!p || p == (void *)1 || p == (void *)2 || p == (void *)3 || p == (void *)-1)
+        p = (void *)GetProcAddress(s_gl32, name);
+    return p;
+}
+
+static int gl_context_create(void)
+{
+    WNDCLASSA wc;
+    PIXELFORMATDESCRIPTOR pfd;
+    int pf;
+
+    s_gl32 = LoadLibraryA("opengl32.dll");
+    if (!s_gl32)
+        return 0;
+    memset(&wc, 0, sizeof wc);
+    wc.style = CS_OWNDC;
+    wc.lpfnWndProc = DefWindowProcA;
+    wc.hInstance = GetModuleHandleA(NULL);
+    wc.lpszClassName = "xboxrecomp_nv2a_gl";
+    RegisterClassA(&wc);
+    s_hwnd = CreateWindowA(wc.lpszClassName, "nv2a", WS_POPUP, 0, 0, 16, 16,
+                           NULL, NULL, wc.hInstance, NULL);
+    if (!s_hwnd)
+        return 0;
+    s_hdc = GetDC(s_hwnd);
+    memset(&pfd, 0, sizeof pfd);
+    pfd.nSize = sizeof pfd;
+    pfd.nVersion = 1;
+    pfd.dwFlags = PFD_DRAW_TO_WINDOW | PFD_SUPPORT_OPENGL | PFD_DOUBLEBUFFER;
+    pfd.iPixelType = PFD_TYPE_RGBA;
+    pfd.cColorBits = 32;
+    pfd.cDepthBits = 24;
+    pfd.cStencilBits = 8;
+    pf = ChoosePixelFormat(s_hdc, &pfd);
+    if (!pf || !SetPixelFormat(s_hdc, pf, &pfd))
+        return 0;
+    /* A legacy context: the drivers give it their full compatibility
+     * profile, which includes everything 3.3 core has. */
+    s_hglrc = wglCreateContext(s_hdc);
+    if (!s_hglrc || !wglMakeCurrent(s_hdc, s_hglrc))
+        return 0;
+    return 1;
+}
+#else
+static SDL_Window   *s_win;
