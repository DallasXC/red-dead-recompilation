+typedef struct { char *p; size_t n, cap; } GStr;
+
+static void gs(GStr *s, const char *fmt, ...)
+#if defined(__GNUC__)
+    __attribute__((format(printf, 2, 3)))
+#endif
+    ;
+#include <stdarg.h>
+static void gs(GStr *s, const char *fmt, ...)
+{
+    va_list ap;
+    int m;
+    for (;;) {
+        size_t room = s->cap - s->n;
+        va_start(ap, fmt);
+        m = vsnprintf(s->p ? s->p + s->n : NULL, s->p ? room : 0, fmt, ap);
+        va_end(ap);
+        if (m < 0)
+            return;
+        if (s->p && (size_t)m < room) {
+            s->n += (size_t)m;
+            return;
+        }
+        {
+            size_t cap = s->cap ? s->cap * 2 : 8192;
+            char *np;
+            while (cap < s->n + (size_t)m + 1)
+                cap *= 2;
+            np = (char *)realloc(s->p, cap);
+            if (!np)
+                return;
+            s->p = np;
+            s->cap = cap;
+        }
+    }
+}
