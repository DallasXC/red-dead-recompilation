+/* ---- the program as GLSL (the host GPU runs it) ---------------------------
+ *
+ * The decoded program again, written out as a GLSL vertex shader body that
+ * computes, operation for operation, what vsh_run_fast does: the same
+ * sources (temps, inputs, constants -- relative ones through a0, out of
+ * range reading c[0]), the same MAC and ILU results (rcc's clamps, lit's
+ * clamp of the power, min/max/slt/sge as the C compares, NaN and all), the
+ * same masks and the same R1 rule for an ILU paired with a MAC. Constants
+ * come from C(i), the inputs are v0..v15 and the outputs oPos, oD0, oD1,
+ * oFog, oT0..oT3 -- declared by the caller around this body.
+ * Programs that write c[] are left to the CPU (nv2a_vsh_gpu_ok). */
+uint32_t nv2a_vsh_const_gen(void) { return s_const_gen; }
+const float *nv2a_vsh_constants(void) { return &s_const[0][0]; }
+
+int nv2a_vsh_gpu_ok(void)
+{
+    return nv2a_vsh_prepare() && s_block_ok;
+}
