+    uint64_t draws, tris, clears, readbacks, uploads, tex_uploads, programs;
+    uint64_t prog_ns, prog_max_ns;      /* building programs: in all, the longest (first use stalls) */
+    uint64_t readback_bytes, dropped, direct, feedback, vsh_draws;
+} s_stat;
+
+static int gl_load(void)
+{
+#define LOAD(ret, name, args) \
+    p_##name = (PFN_##name)gl_proc(#name); \
+    if (!p_##name) { fprintf(stderr, "[GPU-GL] missing %s\n", #name); return 0; }
+    GLFUNCS(LOAD)
+#undef LOAD
+    return 1;
+}
+
+static const char *s_vs_src =
+    "#version 330\n"
+    "layout(location=0) in vec4 aPos;\n"
+    "layout(location=1) in vec4 aD0;\n"
+    "layout(location=2) in vec4 aD1;\n"
+    "layout(location=3) in vec4 aT0;\n"
+    "layout(location=4) in vec4 aT1;\n"
+    "layout(location=5) in vec4 aT2;\n"
+    "layout(location=6) in vec4 aT3;\n"
+    "layout(location=7) in vec4 aFog;\n"
+    "uniform vec4 uVp;\n"   /* 2/width, 2/height, 1/zmax */
+    "out vec4 vD0; out vec4 vD1; out vec4 vT0; out vec4 vT1; out vec4 vT2; out vec4 vT3;\n"
+    "out float vFog;\n"
+    "void main() {\n"
+    "  float w = aPos.w;\n"
+    "  vec4 p = vec4(aPos.x * uVp.x - 1.0, aPos.y * uVp.y - 1.0,\n"
+    "                aPos.z * uVp.z * 2.0 - 1.0, 1.0);\n"
+    "  gl_Position = p * w;\n"
+    "  vD0 = aD0; vD1 = aD1; vT0 = aT0; vT1 = aT1; vT2 = aT2; vT3 = aT3;\n"
+    "  vFog = aFog.x;\n"
+    "}\n";
+
+static GLuint gl_compile(GLenum type, const char *src)
+{
+    GLuint sh = p_glCreateShader(type);
+    GLint ok = 0;
+    p_glShaderSource(sh, 1, &src, NULL);
+    p_glCompileShader(sh);
+    p_glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[4096];
+        p_glGetShaderInfoLog(sh, sizeof log, NULL, log);
+        fprintf(stderr, "[GPU-GL] shader compile failed:\n%s\n--- source ---\n%s\n", log, src);
+        p_glDeleteShader(sh);
+        return 0;
+    }
+    return sh;
+}
+
+static GLuint white_texture(GLenum target)
+{
+    static const uint32_t white = 0xFFFFFFFFu;
+    GLuint t;
+    int f;
+    p_glGenTextures(1, &t);
+    p_glBindTexture(target, t);
+    if (target == GL_TEXTURE_CUBE_MAP) {
+        for (f = 0; f < 6; f++)
+            p_glTexImage2D(GL_TEXTURE_CUBE_MAP_POSITIVE_X + f, 0, GL_RGBA8, 1, 1, 0,
+                           GL_BGRA, GL_UNSIGNED_BYTE, &white);
+    } else {
+        p_glTexImage2D(target, 0, GL_RGBA8, 1, 1, 0, GL_BGRA, GL_UNSIGNED_BYTE, &white);
+    }
+    p_glTexParameteri(target, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    p_glTexParameteri(target, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    return t;
+}
+
+int nvgl_enabled(void)
+{
+    if (s_state)
+        return s_state > 0;
+    {
+        const char *e = getenv("RECOMP_GPU");
+        s_verbose = getenv("RECOMP_GPU_VERBOSE") != NULL;
+        if (e && e[0] == '0') {
+            s_state = -1;
+            return 0;
+        }
+    }
+    s_state = -1;
+    if (!gl_context_create() || !gl_load()) {
+        fprintf(stderr, "[GPU-GL] OpenGL 3.3 is not available; drawing on the CPU\n");
+        return 0;
+    }
+    s_vs = gl_compile(GL_VERTEX_SHADER, s_vs_src);
+    if (!s_vs) {
+        fprintf(stderr, "[GPU-GL] vertex shader failed; drawing on the CPU\n");
+        return 0;
+    }
+    p_glGenVertexArrays(1, &s_vao);
+    p_glBindVertexArray(s_vao);
+    p_glGenBuffers(1, &s_vbo);
+    p_glBindBuffer(GL_ARRAY_BUFFER, s_vbo);
+    p_glBufferData(GL_ARRAY_BUFFER, NVGL_VB_BYTES, NULL, GL_STREAM_DRAW);
+    {
+        int i;
+        for (i = 0; i < 8; i++)
+            p_glEnableVertexAttribArray((GLuint)i);
+        p_glVertexAttribPointer(0, 4, GL_FLOAT, 0, sizeof(NvGlVertex), (void *)offsetof(NvGlVertex, pos));
+        p_glVertexAttribPointer(1, 4, GL_FLOAT, 0, sizeof(NvGlVertex), (void *)offsetof(NvGlVertex, d0));
+        p_glVertexAttribPointer(2, 4, GL_FLOAT, 0, sizeof(NvGlVertex), (void *)offsetof(NvGlVertex, d1));
+        for (i = 0; i < 4; i++)
+            p_glVertexAttribPointer((GLuint)(3 + i), 4, GL_FLOAT, 0, sizeof(NvGlVertex),
+                                    (void *)(offsetof(NvGlVertex, tex) + 16 * (size_t)i));
+        p_glVertexAttribPointer(7, 4, GL_FLOAT, 0, sizeof(NvGlVertex), (void *)offsetof(NvGlVertex, fog));
+    }
+    s_white2d = white_texture(GL_TEXTURE_2D);
+    s_whitecube = white_texture(GL_TEXTURE_CUBE_MAP);
+    p_glEnable(GL_DEPTH_CLAMP);
+    p_glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    p_glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    options_from_env();
+    {
+        GLfloat m = 1.0f;
+        while (p_glGetError() != GL_NO_ERROR) ;
+        p_glGetFloatv(GL_MAX_TEXTURE_MAX_ANISOTROPY, &m);
+        s_aniso_max = (p_glGetError() == GL_NO_ERROR && m >= 1.0f) ? m : 1.0f;
+        s_aniso = (float)s_opt.aniso;
+        if (s_aniso > s_aniso_max) s_aniso = s_aniso_max;
+    }
+    if (s_rs > 1 || s_aniso > 1.0f)
+        fprintf(stderr, "[GPU-GL] render scale %dx, anisotropic filtering %gx\n",
+                s_rs, (double)s_aniso);
+    fprintf(stderr, "[GPU-GL] drawing on the graphics card: %s, OpenGL %s\n",
+            (const char *)p_glGetString(GL_RENDERER),
+            (const char *)p_glGetString(GL_VERSION));
+    s_state = 1;
+    return 1;
+}
+
+void nvgl_set_write_hook(void (*fn)(uint32_t lo, uint32_t hi))
+{
+    s_write_hook = fn;
+}
+
+/* ---- State cache ----------------------------------------------------
+ *
+ * A frame is a thousand or more draws, most changing one or two pieces of
+ * state. Every GL call is driver work on this thread, so state already set
+ * is not set again. Anything that changes GL state goes through these. */
+static struct {
+    int valid;
+    GLuint prog;
+    int blend, depth, stencil, scissor;
+    GLenum bsrc, bdst, beq;
+    uint32_t bcolor;
+    uint32_t cmask;
+    GLenum dfunc;
+    int dmask;
+    GLenum sfunc, sfail, szfail, szpass;
+    GLint sref;
+    GLuint smask, swmask;
+    GLint sx, sy, sw, sh;
+    GLuint tex[8];
+    int active;              /* glActiveTexture unit, -1 unknown */
+} c;
+
+static void c_cap(GLenum cap, int *cur, int on)
+{
+    if (c.valid && *cur == on)
+        return;
+    if (on) p_glEnable(cap); else p_glDisable(cap);
+    *cur = on;
+}
+
+/* A deleted texture is unbound from every unit; forget it so a name GL
+ * hands out again is bound for real. */
+static void c_forget_texture(GLuint tex)
+{
+    int u;
+    for (u = 0; u < 8; u++)
+        if ((c.tex[u] & 0x7FFFFFFFu) == tex)
+            c.tex[u] = 0xFFFFFFFFu;
+}
+
+static void c_validate(void)
+{
+    if (c.valid)
+        return;
+    /* Unknown: force every setter to issue its call once. */
+    memset(&c, 0xFF, sizeof c);
+    c.valid = 0;
+    c_cap(GL_BLEND, &c.blend, 0);
+    c_cap(GL_DEPTH_TEST, &c.depth, 0);
+    c_cap(GL_STENCIL_TEST, &c.stencil, 0);
+    c_cap(GL_SCISSOR_TEST, &c.scissor, 0);
+    c.valid = 1;
+}
+
+static void c_colormask(uint32_t m)        /* bits: R 1, G 2, B 4, A 8 */
+{
+    if (c.cmask == m)
+        return;
+    p_glColorMask((m & 1) != 0, (m & 2) != 0, (m & 4) != 0, (m & 8) != 0);
+    c.cmask = m;
+}
+
+static void c_depthmask(int on)
+{
+    if (c.dmask == on)
+        return;
+    p_glDepthMask(on ? 1 : 0);
+    c.dmask = on;
+}
+
+static void c_stencilmask(GLuint m)
+{
+    if (c.swmask == m)
+        return;
+    p_glStencilMask(m);
+    c.swmask = m;
+}
+
+static void c_scissor(GLint x, GLint y, GLint w, GLint h)
+{
+    c_cap(GL_SCISSOR_TEST, &c.scissor, 1);
+    if (c.sx == x && c.sy == y && c.sw == w && c.sh == h)
+        return;
+    p_glScissor(x, y, w, h);
+    c.sx = x; c.sy = y; c.sw = w; c.sh = h;
+}
+
+static void c_program(GLuint prog)
+{
+    if (c.prog == prog)
+        return;
+    p_glUseProgram(prog);
+    c.prog = prog;
+}
+
+/* Bind tex on unit and leave unit active: callers go on to set the
+ * texture's parameters or upload to it, and those calls act on whatever
+ * the active unit holds. Skipping glActiveTexture along with the bind when
+ * the texture was already there sent them to another unit's texture -- a
+ * render target's, which an upload then re-specified at another size. */
+static void c_texture(int unit, GLenum target, GLuint tex)
+{
+    GLuint key = tex ^ (target == GL_TEXTURE_2D ? 0u : 0x80000000u);
+    if (c.active != unit) {
+        p_glActiveTexture(GL_TEXTURE0 + (GLenum)unit);
+        c.active = unit;
+    }
+    if (c.tex[unit] == key)
+        return;
+    p_glBindTexture(target, tex);
+    c.tex[unit] = key;
+}
+
+/* ---- Hashing --------------------------------------------------------- */
+
+static uint64_t hash_bytes(const uint8_t *p, size_t n)
+{
+    uint64_t h = 1469598103934665603ull;
+    size_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        uint64_t w;
+        memcpy(&w, p + i, 8);
+        h = (h ^ w) * 1099511628211ull;
+        h ^= h >> 29;
+    }
+    for (; i < n; i++)
+        h = (h ^ p[i]) * 1099511628211ull;
+    return h;
+}
+
+/* ---- Swizzle --------------------------------------------------------- */
+
+/* Morton order as the NV2A lays out swizzled images: x and y bits
+ * interleave from bit 0, x first, until the shorter side runs out. */
+static void swz_offsets(uint32_t w, uint32_t h, uint32_t *xo, uint32_t *yo)
+{
+    uint32_t mx = 0, my = 0, bit = 1, i = 1, j = 1, x, y;
+    while (i < w || j < h) {
+        if (i < w) { mx |= bit; bit <<= 1; i <<= 1; }
+        if (j < h) { my |= bit; bit <<= 1; j <<= 1; }
+    }
+    for (x = 0; x < w; x++) {
+        uint32_t v = x, m = mx, r = 0, b;
+        for (b = 1; m; b <<= 1)
+            if (m & b) { if (v & 1) r |= b; v >>= 1; m &= ~b; }
+        xo[x] = r;
+    }
+    for (y = 0; y < h; y++) {
+        uint32_t v = y, m = my, r = 0, b;
+        for (b = 1; m; b <<= 1)
+            if (m & b) { if (v & 1) r |= b; v >>= 1; m &= ~b; }
+        yo[y] = r;
+    }
+}
+
+/* ---- Surfaces -------------------------------------------------------- */
+
+#define NVGL_SURFS 32
+#define NVGL_ZETAS 8
+#define NVGL_FBOS  48
+
+typedef struct {
+    int      used;
+    uint32_t va, pitch, bpp, fmt, swz, w, h;
+    uint32_t gw, gh;         /* the GL texture: w, h times the render scale */
+    GLuint   tex;
+    int      dirty;          /* the GPU's copy is newer than guest memory */
+    int      stale;          /* guest memory is newer: upload before use */
+    uint64_t hash;           /* guest bytes when the two last agreed */
+    uint64_t qhash;          /* the same bytes sampled (surf_qhash) */
+    uint32_t full_frame;     /* the frame hash was last taken whole */
+    uint32_t last_frame;
+} GlSurf;
+
+typedef struct {
+    int used;
+    uint32_t va, w, h;
+    GLuint rb;
+    uint32_t last_frame;
+} GlZeta;
+
+typedef struct {
+    int used;
+    GlSurf *c;
+    GlZeta *z;
+    GLuint fbo;
+} GlFbo;
+
+/* Render scale (s_rs): render targets are that many times the guest's size
+ * on the GPU (RECOMP_RENDER_SCALE, 1-8; GlSurf gw/gh). Coordinates stay in
+ * guest pixels -- the viewport and scissor are what scale -- so nothing the
+ * title sends changes. Guest memory always holds the 1x image: uploads are
+ * scaled up and read-backs scaled down. A change applies at the next frame. */
+static GlSurf s_surf[NVGL_SURFS];
+static GlZeta s_zeta[NVGL_ZETAS];
+static GlFbo  s_fbo[NVGL_FBOS];
+static GlFbo *s_cur_fbo;
+static GlSurf *s_cur_surf;
+static uint32_t *s_tmp;
+static size_t s_tmp_n;
+
+static uint32_t *tmp_buf(size_t texels)
+{
+    if (texels > s_tmp_n) {
+        free(s_tmp);
+        s_tmp = (uint32_t *)malloc(texels * 4);
+        s_tmp_n = s_tmp ? texels : 0;
+    }
+    return s_tmp;
+}
+
+static uint32_t surf_bytes(const GlSurf *s)
+{
+    return s->swz ? s->w * s->h * s->bpp : s->pitch * s->h;
+}
+
+static uint64_t surf_hash(const GlSurf *s)
+{
+    return hash_bytes((const uint8_t *)xbox_GetMemoryOffset() + s->va, surf_bytes(s));
+}
+
+/* A sixteenth of the bytes: 64 in every KB, and the last 64. Taken each
+ * time a surface becomes the render target again -- whole, with split
+ * screen's many target switches a frame, that hashed gigabytes a second
+ * (perf: a sixth of the push-buffer thread). A title that writes a surface
+ * itself (a movie frame, a clear by CPU) changes it everywhere, which this
+ * sees; the whole hash is still taken every 16th frame (nvgl_surf_check). */
+static uint64_t surf_qhash(const GlSurf *s)
+{
+    const uint8_t *m = (const uint8_t *)xbox_GetMemoryOffset() + s->va;
+    uint32_t n = surf_bytes(s), o;
+    uint64_t h = 1469598103934665603ull;
+    if (n <= 65536)
+        return hash_bytes(m, n);
+    for (o = 0; o + 64 <= n; o += 1024)
+        h = (h ^ hash_bytes(m + o, 64)) * 1099511628211ull;
+    return h ^ hash_bytes(m + n - 64, 64);
+}
+
+/* Both hashes, as guest memory and the GPU's copy agree now. */
+static void surf_rehash(GlSurf *s, uint32_t frame)
+{
+    s->hash = surf_hash(s);
+    s->qhash = surf_qhash(s);
+    s->full_frame = frame;
+}
+
+static uint32_t c565(uint16_t v)
+{
+    uint32_t r = (v >> 11) & 31, g = (v >> 5) & 63, b = v & 31;
+    return 0xFF000000u | ((r * 255 / 31) << 16) | ((g * 255 / 63) << 8) | (b * 255 / 31);
+}
+
+static uint32_t c1555(uint16_t v)
+{
+    uint32_t r = (v >> 10) & 31, g = (v >> 5) & 31, b = v & 31;
+    return 0xFF000000u | ((r * 255 / 31) << 16) | ((g * 255 / 31) << 8) | (b * 255 / 31);
+}
+
+/* Uploads bind on unit 7, which no draw samples from. */
+static void bind_scratch(GLenum target, GLuint tex)
+{
+    p_glActiveTexture(GL_TEXTURE0 + 7);
+    p_glBindTexture(target, tex);
+    c.tex[7] = 0xFFFFFFFFu;
+    c.active = 7;
+}
+
+/* 1x scratch: a guest-sized image on its way to or from a scaled surface. */
+static GLuint s_one_tex, s_one_fbo, s_rd_fbo;
+static uint32_t s_one_w, s_one_h;
+
+static void one_size(uint32_t w, uint32_t h)
+{
+    if (!s_one_tex) {
+        p_glGenTextures(1, &s_one_tex);
+        p_glGenFramebuffers(1, &s_one_fbo);
+        p_glGenFramebuffers(1, &s_rd_fbo);
+    }
+    if (w > s_one_w || h > s_one_h) {
+        s_one_w = w > s_one_w ? w : s_one_w;
+        s_one_h = h > s_one_h ? h : s_one_h;
+        bind_scratch(GL_TEXTURE_2D, s_one_tex);
+        p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, (GLsizei)s_one_w, (GLsizei)s_one_h, 0,
+                       GL_BGRA, GL_UNSIGNED_BYTE, NULL);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+        p_glBindFramebuffer(GL_FRAMEBUFFER, s_one_fbo);
+        p_glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, s_one_tex, 0);
+        s_cur_fbo = NULL;
+    }
+}
+
+/* Copy between a surface texture and the 1x scratch, scaling. to_surf: the
+ * scratch's top-left w x h onto the whole surface, else the reverse. */
+static void one_blit(GlSurf *s, int to_surf)
+{
+    p_glBindFramebuffer(GL_READ_FRAMEBUFFER, to_surf ? s_one_fbo : s_rd_fbo);
+    p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, to_surf ? s_rd_fbo : s_one_fbo);
+    if (to_surf)
+        p_glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, s->tex, 0);
+    else
+        p_glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, s->tex, 0);
+    c_validate();
+    c_cap(GL_SCISSOR_TEST, &c.scissor, 0);
+    c_colormask(15);
+    if (to_surf)
+        p_glBlitFramebuffer(0, 0, (GLint)s->w, (GLint)s->h, 0, 0, (GLint)s->gw, (GLint)s->gh,
+                            GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    else
+        p_glBlitFramebuffer(0, 0, (GLint)s->gw, (GLint)s->gh, 0, 0, (GLint)s->w, (GLint)s->h,
+                            GL_COLOR_BUFFER_BIT, GL_LINEAR);
+    p_glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    s_cur_fbo = NULL;
+}
+
+/* Pixels into the surface: straight in at 1x, through the scratch when
+ * scaled. row_len: source row length in texels (0: w). */
+static void surf_put(GlSurf *s, const void *px, GLint row_len)
+{
+    if (s->gw == s->w && s->gh == s->h) {
+        bind_scratch(GL_TEXTURE_2D, s->tex);
+        p_glPixelStorei(GL_UNPACK_ROW_LENGTH, row_len);
+        p_glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, (GLsizei)s->w, (GLsizei)s->h,
+                          GL_BGRA, GL_UNSIGNED_BYTE, px);
+        p_glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+        return;
+    }
+    one_size(s->w, s->h);
+    bind_scratch(GL_TEXTURE_2D, s_one_tex);
+    p_glPixelStorei(GL_UNPACK_ROW_LENGTH, row_len);
+    p_glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, (GLsizei)s->w, (GLsizei)s->h,
+                      GL_BGRA, GL_UNSIGNED_BYTE, px);
+    p_glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    one_blit(s, 1);
+}
+
+/* Guest bytes -> the GL texture. */
+static void surf_upload(GlSurf *s)
+{
+    const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset() + s->va;
+    uint32_t x, y;
+
+    if (!s->swz && s->bpp == 4) {
+        surf_put(s, mem, (GLint)(s->pitch / 4));
+    } else {
+        uint32_t *out = tmp_buf((size_t)s->w * s->h);
+        uint32_t *xo = NULL, *yo = NULL;
+        if (!out)
+            return;
+        if (s->swz) {
+            xo = (uint32_t *)malloc(sizeof(uint32_t) * (s->w + s->h));
+            if (!xo)
+                return;
+            yo = xo + s->w;
+            swz_offsets(s->w, s->h, xo, yo);
+        }
+        for (y = 0; y < s->h; y++)
+            for (x = 0; x < s->w; x++) {
+                size_t i = s->swz ? (size_t)(xo[x] | yo[y]) * s->bpp
+                                  : (size_t)y * s->pitch + (size_t)x * s->bpp;
+                uint32_t c;
+                if (s->bpp == 4) {
+                    memcpy(&c, mem + i, 4);
+                } else {
+                    uint16_t v;
+                    memcpy(&v, mem + i, 2);
+                    c = s->fmt == 3 ? c565(v) : c1555(v);
+                }
+                out[(size_t)y * s->w + x] = c;
+            }
+        free(xo);
+        surf_put(s, out, 0);
+    }
+    s_stat.uploads++;
+}
+
+static GlFbo *fbo_for(GlSurf *c, GlZeta *z);
+static void nvgl_sync_range_except(uint32_t lo, uint32_t hi, const GlSurf *skip);
+
+/* The GL texture -> guest bytes. */
+static void surf_readback(GlSurf *s)
+{
+    uint8_t *mem = (uint8_t *)xbox_GetMemoryOffset() + s->va;
+    uint32_t x, y;
+    GlFbo *f;
+
+    if (!s->dirty)
+        return;
+    /* Guest memory has to be what it was when the GPU took the surface over.
+     * If something else wrote those bytes since (the title reused the
+     * memory), the GPU's copy is stale: drop it rather than write it over
+     * whatever lives there now. */
+    if (surf_hash(s) != s->hash) {
+        s->dirty = 0;
+        surf_rehash(s, s_frame);
+        s->stale = 1;
+        s_stat.dropped++;
+        return;
+    }
+    if (s->gw != s->w || s->gh != s->h) {
+        /* Scaled: down to 1x in the scratch, and read that. */
+        one_size(s->w, s->h);
+        one_blit(s, 0);
+        p_glBindFramebuffer(GL_FRAMEBUFFER, s_one_fbo);
+    } else {
+        f = fbo_for(s, NULL);
+        if (!f)
+            return;
+        p_glBindFramebuffer(GL_FRAMEBUFFER, f->fbo);
+    }
+    s_cur_fbo = NULL;                       /* rebind before the next draw */
+    if (!s->swz && s->bpp == 4) {
+        p_glPixelStorei(GL_PACK_ROW_LENGTH, (GLint)(s->pitch / 4));
+        p_glReadPixels(0, 0, (GLsizei)s->w, (GLsizei)s->h, GL_BGRA, GL_UNSIGNED_BYTE, mem);
+        p_glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    } else {
+        uint32_t *in = tmp_buf((size_t)s->w * s->h);
+        uint32_t *xo = NULL, *yo = NULL;
+        if (!in)
+            return;
+        p_glReadPixels(0, 0, (GLsizei)s->w, (GLsizei)s->h, GL_BGRA, GL_UNSIGNED_BYTE, in);
+        if (s->swz) {
+            xo = (uint32_t *)malloc(sizeof(uint32_t) * (s->w + s->h));
+            if (!xo)
+                return;
+            yo = xo + s->w;
+            swz_offsets(s->w, s->h, xo, yo);
+        }
+        for (y = 0; y < s->h; y++)
+            for (x = 0; x < s->w; x++) {
+                size_t i = s->swz ? (size_t)(xo[x] | yo[y]) * s->bpp
+                                  : (size_t)y * s->pitch + (size_t)x * s->bpp;
+                uint32_t c = in[(size_t)y * s->w + x];
+                if (s->bpp == 4) {
+                    memcpy(mem + i, &c, 4);
+                } else {
+                    uint16_t v;
+                    if (s->fmt == 3)
+                        v = (uint16_t)(((c >> 8) & 0xF800) | ((c >> 5) & 0x07E0) | ((c >> 3) & 0x1F));
+                    else
+                        v = (uint16_t)(0x8000 | ((c >> 9) & 0x7C00) | ((c >> 6) & 0x03E0) | ((c >> 3) & 0x1F));
+                    memcpy(mem + i, &v, 2);
+                }
+            }
+        free(xo);
+    }
+    s->dirty = 0;
+    surf_rehash(s, s_frame);
+    s_stat.readbacks++;
+    s_stat.readback_bytes += surf_bytes(s);
+    if (s_write_hook)
+        s_write_hook(s->va & 0x0FFFFFFFu, (s->va & 0x0FFFFFFFu) + surf_bytes(s));
+}
+
+static void fbo_drop_for(GlSurf *c, GlZeta *z)
+{
+    int i;
+    for (i = 0; i < NVGL_FBOS; i++)
+        if (s_fbo[i].used && ((c && s_fbo[i].c == c) || (z && s_fbo[i].z == z))) {
+            p_glDeleteFramebuffers(1, &s_fbo[i].fbo);
+            if (s_cur_fbo == &s_fbo[i])
+                s_cur_fbo = NULL;
+            memset(&s_fbo[i], 0, sizeof s_fbo[i]);
+        }
+}
+
+static void surf_free(GlSurf *s, int keep)
+{
+    if (keep)
+        surf_readback(s);
+    fbo_drop_for(s, NULL);
+    c_forget_texture(s->tex);
+    p_glDeleteTextures(1, &s->tex);
+    if (s_cur_surf == s)
+        s_cur_surf = NULL;
+    memset(s, 0, sizeof *s);
+}
+
+static GlFbo *fbo_for(GlSurf *c, GlZeta *z)
+{
+    int i, victim = -1;
+    GlFbo *f;
+    for (i = 0; i < NVGL_FBOS; i++) {
+        if (s_fbo[i].used && s_fbo[i].c == c && s_fbo[i].z == z)
+            return &s_fbo[i];
+        if (!s_fbo[i].used && victim < 0)
+            victim = i;
+    }
+    if (victim < 0) {
+        victim = (int)(s_frame % NVGL_FBOS);
+        p_glDeleteFramebuffers(1, &s_fbo[victim].fbo);
+        if (s_cur_fbo == &s_fbo[victim])
+            s_cur_fbo = NULL;
+    }
+    f = &s_fbo[victim];
+    memset(f, 0, sizeof *f);
+    f->used = 1;
+    f->c = c;
+    f->z = z;
+    p_glGenFramebuffers(1, &f->fbo);
+    p_glBindFramebuffer(GL_FRAMEBUFFER, f->fbo);
+    p_glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, c->tex, 0);
+    if (z)
+        p_glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT,
+                                    GL_RENDERBUFFER, z->rb);
+    if (p_glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+        fprintf(stderr, "[GPU-GL] framebuffer for 0x%08X (%ux%u) incomplete\n",
+                c->va, c->w, c->h);
+    }
+    s_cur_fbo = NULL;
+    return f;
+}
+
+static int surf_overlap(const GlSurf *s, uint32_t lo, uint32_t hi)
+{
+    uint32_t a = s->va & 0x0FFFFFFFu;
+    return a < hi && lo < a + surf_bytes(s);
+}
+
+static void nvgl_sync_range_except(uint32_t lo, uint32_t hi, const GlSurf *skip)
+{
+    int i;
+    for (i = 0; i < NVGL_SURFS; i++)
+        if (&s_surf[i] != skip && s_surf[i].used && s_surf[i].dirty
+            && surf_overlap(&s_surf[i], lo, hi))
+            surf_readback(&s_surf[i]);
+}
+
+static GlSurf *surf_backing(uint32_t va, uint32_t pitch, uint32_t bpp,
+                            uint32_t swz, uint32_t w, uint32_t h, int need_dirty)
+{
+    int i;
+    for (i = 0; i < NVGL_SURFS; i++) {
+        GlSurf *s = &s_surf[i];
+        if (!s->used || (need_dirty && !s->dirty) || s->stale || s->va != va
+            || s->bpp != bpp || s->swz != swz)
+            continue;
+        if (swz ? (s->w == w && s->h == h)
+                : (s->pitch == pitch && w <= s->w && h <= s->h))
+            return s;
+    }
+    return NULL;
+}
+
+int nvgl_surface_backs(uint32_t va, uint32_t pitch, uint32_t bpp, uint32_t swz,
+                       uint32_t w, uint32_t h)
+{
+    if (s_state <= 0)
+        return 0;
+    return surf_backing(va, pitch, bpp, swz, w, h, 1) != NULL;
+}
+
+void nvgl_sync_range(uint32_t lo, uint32_t hi)
+{
+    int i;
+    if (s_state <= 0)
+        return;
+    for (i = 0; i < NVGL_SURFS; i++)
+        if (s_surf[i].used && s_surf[i].dirty && surf_overlap(&s_surf[i], lo, hi))
+            surf_readback(&s_surf[i]);
+}
+
+int nvgl_range_dirty(uint32_t lo, uint32_t hi)
+{
+    int i;
+    if (s_state <= 0)
+        return 0;
+    for (i = 0; i < NVGL_SURFS; i++)
+        if (s_surf[i].used && s_surf[i].dirty && surf_overlap(&s_surf[i], lo, hi))
+            return 1;
+    return 0;
+}
+
+void nvgl_sync_all(void)
+{
+    int i;
+    if (s_state <= 0)
+        return;
+    for (i = 0; i < NVGL_SURFS; i++)
+        if (s_surf[i].used && s_surf[i].dirty)
+            surf_readback(&s_surf[i]);
+}
+
+void nvgl_end_frame(void)
+{
+    int i;
+    if (s_state <= 0)
+        return;
+    s_frame++;
+    s_cur_surf = NULL;           /* re-check guest bytes when next drawn to */
+    if (s_rs_want != s_rs) {
+        /* New render scale: every surface back to guest memory at the old
+         * size, then rebuilt at the new one as it is next used. */
+        for (i = 0; i < NVGL_SURFS; i++)
+            if (s_surf[i].used)
+                surf_free(&s_surf[i], 1);
+        for (i = 0; i < NVGL_ZETAS; i++)
+            if (s_zeta[i].used) {
+                fbo_drop_for(NULL, &s_zeta[i]);
+                p_glDeleteRenderbuffers(1, &s_zeta[i].rb);
+                memset(&s_zeta[i], 0, sizeof s_zeta[i]);
+            }
+        fprintf(stderr, "[GPU-GL] render scale %dx -> %dx\n", s_rs, s_rs_want);
+        s_rs = s_rs_want;
+    }
+    /* Surfaces nobody has drawn to for a while: free them -- but what the
+     * GPU drew goes back to guest memory first. Not drawn to is not unused:
+     * a title can draw an image into a surface once and then only sample it.
+     * Red Dead Revolver's Showdown loading screen is drawn once into its own
+     * 720x480 target and then copied to the screen every frame while the
+     * level loads; freed without a read-back, the next copy came from guest
+     * memory that had never held the picture (level data) -- a screen of
+     * coloured noise under "Press START", ten seconds in, the same every
+     * time. The read-back checks that the memory is still the surface's
+     * (its hash, as when the GPU took it over) and drops the GPU's copy
+     * instead if the title has put something else there. */
+    for (i = 0; i < NVGL_SURFS; i++)
+        if (s_surf[i].used && s_frame - s_surf[i].last_frame > 600)
+            surf_free(&s_surf[i], 1);
+    for (i = 0; i < NVGL_ZETAS; i++)
+        if (s_zeta[i].used && s_frame - s_zeta[i].last_frame > 600) {
+            fbo_drop_for(NULL, &s_zeta[i]);
+            p_glDeleteRenderbuffers(1, &s_zeta[i].rb);
+            memset(&s_zeta[i], 0, sizeof s_zeta[i]);
+        }
+}
+
+static GlSurf *surf_get(const NvGlSurface *d)
+{
+    uint32_t w, h;
+    GlSurf *s = NULL, *victim = NULL;
+    int i;
+
+    if (!d->va || (d->bpp != 2 && d->bpp != 4))
+        return NULL;
+    if (d->swizzled) {
+        w = d->width;
+        h = d->height;
+    } else {
+        if (!d->pitch)
+            return NULL;
+        w = d->pitch / d->bpp;
+        h = d->clip_y + d->clip_h;
+        if (d->height > h)
+            h = d->height;
+    }
+    if (!w || !h || w > 8192 || h > 8192)
+        return NULL;
+    for (i = 0; i < NVGL_SURFS; i++) {
+        GlSurf *c = &s_surf[i];
+        if (c->used && c->va == d->va && c->pitch == d->pitch && c->bpp == d->bpp
+            && c->swz == d->swizzled && (c->swz ? c->w == w && c->h == h : 1)) {
+            s = c;
+            break;
+        }
+        if (!victim || !c->used || (victim->used && c->last_frame < victim->last_frame))
+            victim = c;
+    }
+    if (s && !s->swz && h > s->h) {
+        /* Taller than before: start again from guest memory. */
+        surf_free(s, 1);
+        victim = s;
+        s = NULL;
+    }
+    if (!s) {
+        if (victim->used)
+            surf_free(victim, 1);
+        s = victim;
+        s->used = 1;
+        s->va = d->va;
+        s->pitch = d->pitch;
+        s->bpp = d->bpp;
+        s->fmt = d->fmt;
+        s->swz = d->swizzled;
+        s->w = w;
+        s->h = h;
+        s->gw = w * (uint32_t)s_rs;
+        s->gh = h * (uint32_t)s_rs;
+        /* Anything still on the GPU that shares these bytes goes back to
+         * guest memory first, so the upload below sees it. */
+        nvgl_sync_range(d->va & 0x0FFFFFFFu, (d->va & 0x0FFFFFFFu) + surf_bytes(s));
+        p_glGenTextures(1, &s->tex);
+        bind_scratch(GL_TEXTURE_2D, s->tex);
+        p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, (GLsizei)s->gw, (GLsizei)s->gh, 0,
+                       GL_BGRA, GL_UNSIGNED_BYTE, NULL);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+        surf_upload(s);
+        surf_rehash(s, s_frame);
+        s->dirty = 0;
+        if (s_verbose)
+            fprintf(stderr, "[GPU-GL] surface 0x%08X %ux%u bpp %u pitch %u%s (clip %u,%u %ux%u)\n",
+                    s->va, w, h, s->bpp, s->pitch, s->swz ? " swizzled" : "",
+                    d->clip_x, d->clip_y, d->clip_w, d->clip_h);
+    } else if (s != s_cur_surf || s->stale) {
+        /* Newly current: did the guest write its bytes meanwhile? Then
+         * those win over whatever the GPU held. */
+        uint64_t hh;
+        if (!s->dirty)
+            nvgl_sync_range_except(d->va & 0x0FFFFFFFu,
+                                   (d->va & 0x0FFFFFFFu) + surf_bytes(s), s);
+        {
+            uint64_t hq = surf_qhash(s);
+            if (s->stale || hq != s->qhash || s_frame - s->full_frame >= 16) {
+                hh = surf_hash(s);
+                s->full_frame = s_frame;
+            } else {
+                hh = s->hash;               /* sampled bytes unchanged */
+            }
+            s->qhash = hq;
+        }
+        if (hh != s->hash || s->stale) {
+            surf_upload(s);
+            s->hash = hh;
+            s->dirty = 0;
+            s->stale = 0;
+        }
+    }
+    s->fmt = d->fmt;
+    s->last_frame = s_frame;
+    s_cur_surf = s;
+    return s;
+}
+
+static GlZeta *zeta_get(uint32_t va, uint32_t w, uint32_t h)
+{
+    GlZeta *z = NULL, *victim = NULL;
+    int i;
+    for (i = 0; i < NVGL_ZETAS; i++) {
+        GlZeta *c = &s_zeta[i];
+        if (c->used && c->va == va && c->w == w && c->h == h) {
+            z = c;
+            break;
+        }
+        if (!victim || !c->used || (victim->used && c->last_frame < victim->last_frame))
+            victim = c;
+    }
+    if (!z) {
+        if (victim->used) {
+            fbo_drop_for(NULL, victim);
+            p_glDeleteRenderbuffers(1, &victim->rb);
+        }
+        z = victim;
+        memset(z, 0, sizeof *z);
+        z->used = 1;
+        z->va = va;
+        z->w = w;
+        z->h = h;
+        p_glGenRenderbuffers(1, &z->rb);
+        p_glBindRenderbuffer(GL_RENDERBUFFER, z->rb);
+        p_glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH24_STENCIL8, (GLsizei)w, (GLsizei)h);
+        /* A new depth buffer reads as cleared to the far plane. */
+        {
+            GLuint f;
+            p_glGenFramebuffers(1, &f);
+            p_glBindFramebuffer(GL_FRAMEBUFFER, f);
+            p_glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT,
+                                        GL_RENDERBUFFER, z->rb);
+            c_validate();
+            c_cap(GL_SCISSOR_TEST, &c.scissor, 0);
+            c_depthmask(1);
+            c_stencilmask(0xFF);
+            p_glClearDepth(1.0);
+            p_glClearStencil(0);
+            p_glClear(GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT);
+            p_glBindFramebuffer(GL_FRAMEBUFFER, 0);
+            p_glDeleteFramebuffers(1, &f);
+            s_cur_fbo = NULL;
+        }
+    }
+    z->last_frame = s_frame;
+    return z;
+}
+
+/* Make the surface (and its depth buffer) the render target. */
+static GlSurf *bind_target(const NvGlSurface *d, int need_z)
+{
+    GlSurf *s = surf_get(d);
+    GlZeta *z = NULL;
+    GlFbo *f;
+    if (!s)
+        return NULL;
+    if (need_z)
+        z = zeta_get(d->zeta_va, s->gw, s->gh);
+    f = fbo_for(s, z);
+    if (f != s_cur_fbo) {
+        p_glBindFramebuffer(GL_FRAMEBUFFER, f->fbo);
+        p_glViewport(0, 0, (GLsizei)s->gw, (GLsizei)s->gh);
+        s_cur_fbo = f;
+    }
+    return s;
+}
+
+static void set_scissor(const NvGlSurface *d, const GlSurf *s,
+                        uint32_t x0, uint32_t y0, uint32_t x1, uint32_t y1)
+{
+    if (x1 > s->w) x1 = s->w;
+    if (y1 > s->h) y1 = s->h;
+    if (x0 > x1) x0 = x1;
+    if (y0 > y1) y0 = y1;
+    (void)d;
+    c_validate();
+    {
+        uint32_t k = (uint32_t)s_rs;
+        if (s->gw != s->w * k) k = s->w ? s->gw / s->w : 1;
+        c_scissor((GLint)(x0 * k), (GLint)(y0 * k), (GLint)((x1 - x0) * k), (GLint)((y1 - y0) * k));
+    }
+}
+
+void nvgl_clear(const NvGlSurface *d, uint32_t flags, uint32_t argb,
+                uint32_t zs, uint32_t x0, uint32_t y0, uint32_t x1, uint32_t y1)
+{
+    GlSurf *s;
+    GLbitfield bits = 0;
+    int need_z = (flags & 0x3) != 0;
+
+    if (s_state <= 0)
+        return;
+    (void)need_z;
+    /* A title may clear a render-to-texture target with the surface set
+     * linear and then draw it swizzled (Red Dead Revolver's menu pages and
+     * their 64x64 thumbnails). A whole-surface clear writes the same bytes
+     * either way, so it goes to the swizzled surface already on the GPU --
+     * otherwise the two views of one image are copied back and forth. */
+    if (!d->swizzled && x0 == 0 && y0 == 0) {
+        int i;
+        for (i = 0; i < NVGL_SURFS; i++) {
+            GlSurf *o = &s_surf[i];
+            if (o->used && o->swz && o->va == d->va && o->bpp == d->bpp
+                && o->w * o->bpp == d->pitch && x1 >= o->w && y1 >= o->h) {
+                NvGlSurface d2 = *d;
+                d2.swizzled = 1;
+                d2.width = o->w;
+                d2.height = o->h;
+                d2.clip_x = d2.clip_y = 0;
+                d2.clip_w = o->w;
+                d2.clip_h = o->h;
+                nvgl_clear(&d2, flags, argb, zs, 0, 0, o->w, o->h);
+                return;
+            }
+        }
+    }
+    s = bind_target(d, 1);   /* depth attached either way: one framebuffer per pair */
+    if (!s)
+        return;
+    set_scissor(d, s, x0, y0, x1, y1);
+    if (flags & 0xF0) {
+        /* CLEAR_SURFACE colour bits: R 0x10, G 0x20, B 0x40, A 0x80. */
+        c_colormask((flags >> 4) & 0xF);
+        p_glClearColor((float)((argb >> 16) & 0xFF) / 255.0f,
+                       (float)((argb >> 8) & 0xFF) / 255.0f,
+                       (float)(argb & 0xFF) / 255.0f,
+                       (float)(argb >> 24) / 255.0f);
+        bits |= GL_COLOR_BUFFER_BIT;
+        s->dirty = 1;
+    }
+    if (flags & 0x1) {
+        float z = d->zfmt == 1 ? (float)(zs & 0xFFFF) / 65535.0f
+                               : (float)(zs >> 8) / 16777215.0f;
+        c_depthmask(1);
+        p_glClearDepth(z);
+        bits |= GL_DEPTH_BUFFER_BIT;
+    }
+    if (flags & 0x2) {
+        c_stencilmask(0xFF);
+        p_glClearStencil((GLint)(zs & 0xFF));
+        bits |= GL_STENCIL_BUFFER_BIT;
+    }
+    if (bits)
+        p_glClear(bits);
+    s_stat.clears++;
+}
+
+/* ---- Textures -------------------------------------------------------- */
+
+#define NVGL_TEX_SLOTS 4096
+
+
+typedef struct {
+    uint64_t key, version, params_key;
+    GLuint tex;
+    uint32_t w, h, cube, mips;
+    uint32_t last_frame;
+    uint32_t uploads;        /* how often its texels changed */
+    uint32_t big;            /* replaced by a bigger picture: always mipmapped */
+} GlTex;
+
+static GlTex s_tex[NVGL_TEX_SLOTS];
+
+static GLint wrap_mode(uint32_t a)
+{
+    switch (a) {
+    case 1: return GL_REPEAT;
+    case 2: return GL_MIRRORED_REPEAT;
+    case 4: return GL_CLAMP_TO_BORDER;
+    default: return GL_CLAMP_TO_EDGE;     /* 3 clamp, 5 clamp (GL) */
+    }
+}
+
+/* ---- Texture packs ---------------------------------------------------
+ *
+ * RECOMP_TEXTURE_DUMP=<dir>: every texture the game uploads is written
+ * there once, as <hash>.tga (32-bit, top-down), the hash taken over its
+ * decoded texels and size -- the same texture gets the same name every run
+ * and on every machine. Textures that keep changing (movies, effects drawn
+ * on the CPU) are written only the first time.
+ *
+ * RECOMP_TEXTURE_PACK=<dir>: a .tga there whose name starts with a texture's
+ * 16-digit hash (anything may follow: "1a2b...ef_wall.tga") is used in its
+ * place, at any size (higher resolution works: coordinates are scaled).
+ * Subfolders are searched too, so packs can be kept apart. Uncompressed or
+ * RLE TGA, 24 or 32 bits. Cube maps are left alone. Several folders, ';'
+ * between them: an earlier one wins a texture both have; "=<dir>" is that
+ * folder's own files only, not its subfolders (a title switching packs
+ * kept in subfolders on and off, with loose files beside them). */
+
+typedef struct { uint64_t hash; char *path; size_t order; } TexPackEntry;
+static TexPackEntry *s_pack;
+static size_t s_pack_n, s_pack_cap;
+static const char *s_dump_dir;
+static int s_pack_init;
+static uint64_t s_pack_hits, s_dumped;
+
+static uint64_t tex_hash(const uint32_t *px, uint32_t w, uint32_t h)
+{
+    uint64_t x = 0x84222325CBF29CE4ull ^ ((uint64_t)w << 32 | h);
+    size_t n = (size_t)w * h, i;
+    for (i = 0; i < n; i++) {
+        x ^= px[i];
+        x *= 0x100000001B3ull;
+        x ^= x >> 29;
+    }
+    x ^= x >> 33;
+    x *= 0xFF51AFD7ED558CCDull;
+    x ^= x >> 33;
+    return x;
+}
+
+static int hexval(int c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static void pack_add(const char *dir, const char *name)
+{
+    uint64_t h = 0;
+    size_t L = strlen(name), i;
+    char *path;
+    if (L < 20 || (strcmp(name + L - 4, ".tga") && strcmp(name + L - 4, ".TGA")))
+        return;
+    for (i = 0; i < 16; i++) {
+        int v = hexval(name[i]);
+        if (v < 0)
+            return;
+        h = h << 4 | (uint64_t)v;
+    }
+    if (s_pack_n == s_pack_cap) {
+        size_t cap = s_pack_cap ? s_pack_cap * 2 : 256;
+        TexPackEntry *n2 = (TexPackEntry *)realloc(s_pack, cap * sizeof *n2);
+        if (!n2)
+            return;
+        s_pack = n2;
+        s_pack_cap = cap;
+    }
+    path = (char *)malloc(strlen(dir) + L + 2);
+    if (!path)
+        return;
+    sprintf(path, "%s/%s", dir, name);
+    s_pack[s_pack_n].hash = h;
+    s_pack[s_pack_n].path = path;
+    s_pack[s_pack_n].order = s_pack_n;
+    s_pack_n++;
+}
+
+static void pack_scan(const char *dir, int depth)
+{
+#if defined(_WIN32)
+    WIN32_FIND_DATAA fd;
+    char pat[1024];
+    HANDLE f;
+    snprintf(pat, sizeof pat, "%s\\*", dir);
+    f = FindFirstFileA(pat, &fd);
+    if (f == INVALID_HANDLE_VALUE)
+        return;
+    do {
+        if (fd.cFileName[0] == '.')
+            continue;
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+            if (depth < 4) {
+                char sub[1024];
+                snprintf(sub, sizeof sub, "%s\\%s", dir, fd.cFileName);
+                pack_scan(sub, depth + 1);
+            }
+        } else
+            pack_add(dir, fd.cFileName);
+    } while (FindNextFileA(f, &fd));
+    FindClose(f);
+#else
+    DIR *d = opendir(dir);
+    struct dirent *de;
+    if (!d)
+        return;
+    while ((de = readdir(d)) != NULL) {
+        char sub[1024];
+        struct stat st;
+        if (de->d_name[0] == '.')
+            continue;
+        snprintf(sub, sizeof sub, "%s/%s", dir, de->d_name);
+        if (stat(sub, &st) == 0 && S_ISDIR(st.st_mode)) {
+            if (depth < 4)
+                pack_scan(sub, depth + 1);
+        } else
+            pack_add(dir, de->d_name);
+    }
+    closedir(d);
+#endif
+}
+
+static int pack_cmp(const void *a, const void *b)
+{
+    const TexPackEntry *p = (const TexPackEntry *)a, *q = (const TexPackEntry *)b;
+    if (p->hash != q->hash)
+        return p->hash < q->hash ? -1 : 1;
+    return p->order < q->order ? -1 : p->order > q->order;     /* the earlier folder first */
+}
+
+static void texpack_init(void)
+{
+    const char *p;
+    if (s_pack_init)
+        return;
+    s_pack_init = 1;
+    p = getenv("RECOMP_TEXTURE_PACK");
+    if (p && *p) {
+        const char *d = p;
+        while (d && *d) {
+            const char *end = strchr(d, ';');
+            size_t len = end ? (size_t)(end - d) : strlen(d);
+            char dir[1024];
+            int flat = len > 1 && d[0] == '=';
+            if (flat) { d++; len--; }
+            if (len > 0 && len < sizeof dir) {
+                memcpy(dir, d, len);
+                dir[len] = 0;
+                pack_scan(dir, flat ? 4 : 0);   /* (depth 4: no further down) */
+            }
+            d = end ? end + 1 : NULL;
+        }
+        if (s_pack_n)
+            qsort(s_pack, s_pack_n, sizeof *s_pack, pack_cmp);
+        fprintf(stderr, "  [TEXPACK] %u replacement texture%s in %s\n",
+                (unsigned)s_pack_n, s_pack_n == 1 ? "" : "s", p);
+    }
+    p = getenv("RECOMP_TEXTURE_DUMP");
+    if (p && *p) {
+        s_dump_dir = p;
+#if defined(_WIN32)
+        CreateDirectoryA(p, NULL);
+#else
+        mkdir(p, 0777);
+#endif
+        fprintf(stderr, "  [TEXPACK] writing textures to %s\n", p);
+    }
+    fflush(stderr);
+}
+
+static nvgl_texture_fn s_tex_hook;
+void nvgl_set_texture_hook(nvgl_texture_fn fn) { s_tex_hook = fn; }
+
+static const char *pack_find(uint64_t h)
+{
+    size_t lo = 0, hi = s_pack_n;
+    while (lo < hi) {
+        size_t m = (lo + hi) / 2;
+        if (s_pack[m].hash < h) lo = m + 1;
+        else hi = m;
+    }
+    return lo < s_pack_n && s_pack[lo].hash == h ? s_pack[lo].path : NULL;
+}
+
+static void tga_write(const char *path, const uint32_t *px, uint32_t w, uint32_t h)
+{
+    FILE *f = fopen(path, "wb");
+    uint8_t hd[18];
+    if (!f)
+        return;
+    memset(hd, 0, sizeof hd);
+    hd[2] = 2;                              /* uncompressed true colour */
+    hd[12] = (uint8_t)w; hd[13] = (uint8_t)(w >> 8);
+    hd[14] = (uint8_t)h; hd[15] = (uint8_t)(h >> 8);
+    hd[16] = 32;
+    hd[17] = 0x28;                          /* 8 alpha bits, top-down */
+    fwrite(hd, 1, sizeof hd, f);
+    fwrite(px, 4, (size_t)w * h, f);        /* B G R A, as TGA wants */
+    fclose(f);
+}
+
+/* A TGA as top-down BGRA (malloc'd), or NULL. */
+static uint32_t *tga_read(const char *path, uint32_t *ow, uint32_t *oh)
+{
+    FILE *f = fopen(path, "rb");
+    uint8_t hd[18];
+    uint32_t w, h, bpp, x, y, n, i;
+    uint32_t *out = NULL;
+    int rle, top;
+    if (!f)
+        return NULL;
+    if (fread(hd, 1, 18, f) != 18)
+        goto fail;
+    w = hd[12] | hd[13] << 8;
+    h = hd[14] | hd[15] << 8;
+    bpp = hd[16] / 8;
+    rle = hd[2] == 10;
+    top = (hd[17] & 0x20) != 0;
+    if ((hd[2] != 2 && hd[2] != 10) || hd[1] || (bpp != 3 && bpp != 4) || !w || !h
+        || w > 8192 || h > 8192)
+        goto fail;
+    fseek(f, hd[0], SEEK_CUR);              /* image id */
+    out = (uint32_t *)malloc((size_t)w * h * 4);
+    if (!out)
+        goto fail;
+    n = w * h;
+    for (i = 0; i < n;) {
+        uint8_t c[4] = { 0, 0, 0, 255 };
+        uint32_t count = 1, raw = 1, k;
+        if (rle) {
+            int r = fgetc(f);
+            if (r < 0) goto fail;
+            count = (uint32_t)(r & 0x7F) + 1;
+            raw = !(r & 0x80);
+        }
+        for (k = 0; k < count && i < n; k++, i++) {
+            if (raw || k == 0) {
+                if (fread(c, 1, bpp, f) != bpp) goto fail;
+                if (bpp == 3) c[3] = 255;
+            }
+            x = i % w;
+            y = i / w;
+            if (!top) y = h - 1 - y;
+            out[(size_t)y * w + x] = (uint32_t)c[0] | (uint32_t)c[1] << 8
+                                   | (uint32_t)c[2] << 16 | (uint32_t)c[3] << 24;
+        }
+    }
+    fclose(f);
+    *ow = w;
+    *oh = h;
+    return out;
+fail:
+    free(out);
+    fclose(f);
+    return NULL;
+}
+
+/* Upload (when new or changed) and bind t to unit `unit`. */
+static int tex_bind(const NvGlTexture *t, int unit)
+{
+    uint32_t slot = (uint32_t)((t->key ^ (t->key >> 29)) * 0x9E3779B97F4A7C15ull >> 52) % NVGL_TEX_SLOTS, i;
+    GlTex *e = NULL, *victim = NULL;
+    GLenum target = t->cube ? GL_TEXTURE_CUBE_MAP : GL_TEXTURE_2D;
+    uint32_t mag = (t->filter >> 24) & 0xF, min = (t->filter >> 16) & 0xFF;
+    int want_mips = t->mipmapped && (min >= 3 && min <= 6);
+
+    for (i = 0; i < 16; i++) {
+        GlTex *c = &s_tex[(slot + i) % NVGL_TEX_SLOTS];
+        if (c->tex && c->key == t->key && c->w == t->width && c->h == t->height
+            && c->cube == t->cube) {
+            e = c;
+            break;
+        }
+        if (!victim || !c->tex || (victim->tex && c->last_frame < victim->last_frame))
+            victim = c;
+    }
+    if (!e) {
+        if (victim->tex) {
+            c_forget_texture(victim->tex);
+            p_glDeleteTextures(1, &victim->tex);
+        }
+        e = victim;
+        memset(e, 0, sizeof *e);
+        e->key = t->key;
+        e->version = ~t->version;
+        e->w = t->width;
+        e->h = t->height;
+        e->cube = t->cube;
+        p_glGenTextures(1, &e->tex);
+    }
+    c_texture(unit, target, e->tex);
+    if (e->version != t->version || (want_mips && !e->mips)) {
+        uint32_t faces = t->cube ? 6 : 1, f;
+        uint32_t *buf = tmp_buf((size_t)t->width * t->height);
+        if (!buf)
+            return 0;
+        texpack_init();
+        for (f = 0; f < faces; f++) {
+            uint32_t *rep = NULL, rw = 0, rh = 0;
+            if (!t->decode(t->ctx, f, buf))
+                memset(buf, 0xFF, (size_t)t->width * t->height * 4);
+            if (!t->cube && (s_pack_n || s_dump_dir || s_tex_hook) && t->width >= 4 && t->height >= 4) {
+                uint64_t hh = tex_hash(buf, t->width, t->height);
+                const char *rp = s_pack_n ? pack_find(hh) : NULL;
+                if (s_dump_dir && e->uploads == 0) {
+                    char path[1024];
+                    snprintf(path, sizeof path, "%s/%016llx.tga", s_dump_dir,
+                             (unsigned long long)hh);
+                    {
+                        FILE *ex = fopen(path, "rb");
+                        if (ex)
+                            fclose(ex);
+                        else {
+                            tga_write(path, buf, t->width, t->height);
+                            s_dumped++;
+                        }
+                    }
+                }
+                if (rp && (rep = tga_read(rp, &rw, &rh)) != NULL)
+                    s_pack_hits++;
+                if (!rep && s_tex_hook)
+                    rep = s_tex_hook(hh, buf, t->width, t->height, &rw, &rh);
+            }
+            e->big = rep && (rw > t->width || rh > t->height);
+            if (rep) {
+                p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, (GLsizei)rw, (GLsizei)rh, 0,
+                               GL_BGRA, GL_UNSIGNED_BYTE, rep);
+                free(rep);
+            } else
+                p_glTexImage2D(t->cube ? GL_TEXTURE_CUBE_MAP_POSITIVE_X + f : GL_TEXTURE_2D,
+                               0, GL_RGBA8, (GLsizei)t->width, (GLsizei)t->height, 0,
+                               GL_BGRA, GL_UNSIGNED_BYTE, buf);
+        }
+        e->uploads++;
+        e->mips = 0;
+        /* a bigger picture is drawn smaller than it is: it needs mipmaps
+         * whatever the game asked for, or it glitters */
+        if (want_mips || e->big) {
+            p_glGenerateMipmap(target);
+            e->mips = 1;
+        }
+        e->version = t->version;
+        e->params_key = ~0ull;
+        s_stat.tex_uploads++;
+    }
+    e->last_frame = s_frame;
+    if (e->params_key != ((uint64_t)t->filter << 32 ^ (uint64_t)t->addr_u << 8 ^ t->addr_v
+                          ^ (uint64_t)t->border_color * 0x9E3779B1u ^ (uint64_t)e->mips << 63
+                          ^ (uint64_t)s_aniso << 20)) {
+        GLint minf;
+        e->params_key = (uint64_t)t->filter << 32 ^ (uint64_t)t->addr_u << 8 ^ t->addr_v
+                      ^ (uint64_t)t->border_color * 0x9E3779B1u ^ (uint64_t)e->mips << 63
+                      ^ (uint64_t)s_aniso << 20;
+        switch (min) {
+        case 2: minf = GL_LINEAR; break;
+        case 3: minf = GL_NEAREST_MIPMAP_NEAREST; break;
+        case 4: minf = GL_LINEAR_MIPMAP_NEAREST; break;
+        case 5: minf = GL_NEAREST_MIPMAP_LINEAR; break;
+        case 6: minf = GL_LINEAR_MIPMAP_LINEAR; break;
+        default: minf = GL_NEAREST; break;
+        }
+        if (!e->mips && minf != GL_LINEAR && minf != GL_NEAREST)
+            minf = (min == 4 || min == 6) ? GL_LINEAR : GL_NEAREST;
+        if (e->big && minf == GL_LINEAR)
+            minf = GL_LINEAR_MIPMAP_LINEAR;
+        p_glTexParameteri(target, GL_TEXTURE_MIN_FILTER, minf);
+        p_glTexParameteri(target, GL_TEXTURE_MAG_FILTER,
+                          (mag == 2 || mag == 4 || min == 2) ? GL_LINEAR : GL_NEAREST);
+        if (s_aniso_max > 1.0f)
+            p_glTexParameterf(target, GL_TEXTURE_MAX_ANISOTROPY,
+                              (e->mips && minf != GL_NEAREST && minf != GL_NEAREST_MIPMAP_NEAREST)
+                                  ? s_aniso : 1.0f);
+        p_glTexParameteri(target, GL_TEXTURE_WRAP_S, t->cube ? GL_CLAMP_TO_EDGE : wrap_mode(t->addr_u));
+        p_glTexParameteri(target, GL_TEXTURE_WRAP_T, t->cube ? GL_CLAMP_TO_EDGE : wrap_mode(t->addr_v));
+        if (t->addr_u == 4 || t->addr_v == 4) {
+            GLfloat bc[4];
+            bc[0] = (float)((t->border_color >> 16) & 0xFF) / 255.0f;
+            bc[1] = (float)((t->border_color >> 8) & 0xFF) / 255.0f;
+            bc[2] = (float)(t->border_color & 0xFF) / 255.0f;
+            bc[3] = (float)(t->border_color >> 24) / 255.0f;
+            p_glTexParameterfv(target, GL_TEXTURE_BORDER_COLOR, bc);
+        }
+    }
+    return 1;
+}
+
+#define GL_TEXTURE_SWIZZLE_A 0x8E45
+#define GL_ALPHA_ENUM        0x1906
+#define GL_ONE_ENUM          1
+
+/* A surface's own texture as a stage's image. Its sampler state is set per
+ * use; the swizzle reads alpha as 1 for an X8 format. */
+static void surf_sample_bind(int unit, GlSurf *src, const NvGlTexture *t)
+{
+    uint32_t mag = (t->filter >> 24) & 0xF, min = (t->filter >> 16) & 0xFF;
+    c_texture(unit, GL_TEXTURE_2D, src->tex);
+    p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER,
+                      (min == 2 || min == 4 || min == 6) ? GL_LINEAR : GL_NEAREST);
+    p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER,
+                      (mag == 2 || mag == 4 || min == 2) ? GL_LINEAR : GL_NEAREST);
+    {
+        /* A surface is a linear texture, and the NV2A only clamps those:
+         * wrap and mirror apply to swizzled textures (D3D on the Xbox
+         * requires clamp for linear ones). Sampled with GL's repeat, the
+         * edge of a page drawn into a surface (the front end's books) took
+         * in the opposite edge: a thin light line along the pages, plainer
+         * at a higher render scale. (A swizzled surface keeps its wrap.)
+         * RECOMP_SURFACE_WRAP=1: as asked, for every surface. */
+        static int keep = -1;
+        GLint ws = wrap_mode(t->addr_u), wt = wrap_mode(t->addr_v);
+        if (keep < 0)
+            keep = getenv("RECOMP_SURFACE_WRAP") && getenv("RECOMP_SURFACE_WRAP")[0] == '1';
+        if (!keep && !src->swz) {
+            if (ws == GL_REPEAT || ws == GL_MIRRORED_REPEAT) ws = GL_CLAMP_TO_EDGE;
+            if (wt == GL_REPEAT || wt == GL_MIRRORED_REPEAT) wt = GL_CLAMP_TO_EDGE;
+        }
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, ws);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, wt);
+        if (getenv("RECOMP_SURFACE_WRAP_LOG")) {
+            static int n;
+            if ((t->addr_u == 1 || t->addr_u == 2 || t->addr_v == 1 || t->addr_v == 2) && n++ < 40)
+                fprintf(stderr, "  [GPU-GL] surface 0x%08X %ux%u sampled with wrap %u/%u\n",
+                        src->va, src->w, src->h, t->addr_u, t->addr_v);
+        }
+    }
+    p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_A, t->x8 ? GL_ONE_ENUM : GL_ALPHA_ENUM);
+}
+
+/* A copy of surface s (the bound render target) in a scratch texture, as a
+ * stand-in GlSurf for surf_sample_bind. */
+static GlSurf *feedback_copy(GlSurf *s)
+{
+    static GlSurf copy;
+    static GLuint tex;
+    static uint32_t w, h;
+    if (!tex || w != s->gw || h != s->gh) {
+        if (!tex)
+            p_glGenTextures(1, &tex);
+        bind_scratch(GL_TEXTURE_2D, tex);
+        p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, (GLsizei)s->gw, (GLsizei)s->gh, 0,
+                       GL_BGRA, GL_UNSIGNED_BYTE, NULL);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+        w = s->gw;
+        h = s->gh;
+    }
+    bind_scratch(GL_TEXTURE_2D, tex);
+    p_glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0, (GLsizei)s->gw, (GLsizei)s->gh);
+    copy = *s;
+    copy.tex = tex;
+    s_stat.feedback++;
+    return &copy;
+}
+
+/* ---- Programs -------------------------------------------------------- */
+
+typedef struct {
+    uint64_t vs;              /* 0: the shared vertex shader; else a vertex program's */
+    uint32_t use_rc, modulate, cube_mask, tex_mask;
+    uint32_t stage_mode[4], clip_plane_mode;
+    uint32_t control, final0, final1;
+    uint32_t color_icw[8], alpha_icw[8], color_ocw[8], alpha_ocw[8];
+} ProgKey;
+
+typedef struct {
+    ProgKey key;
+    GLuint prog;
+    GLint uVp, uC0, uC1, uFC0, uFC1, uFog, uAlpha, uTexScale, uTexClamp;
+    GLint uCbBase, uAa, uFogP;           /* vertex-program shaders only */
+    int u_cb; float u_aa[4], u_fp[4];
+    int used;
+    /* Last values sent, so unchanged uniforms are not sent again. */
+    float u_vp[4], u_sc[4][2], u_al[2], u_cc[2][8][4], u_f[3][4], u_cl[4][4];
+} GlProg;
+
+#define NVGL_PROGS 1024
+static GlProg s_prog[NVGL_PROGS];
+
+typedef struct { char *p; size_t n, cap; } Str;
+
+static void sa(Str *s, const char *fmt, ...)
+#if defined(__GNUC__)
+    __attribute__((format(printf, 2, 3)))
+#endif
+    ;
+
+#include <stdarg.h>
+static void sa(Str *s, const char *fmt, ...)
+{
+    va_list ap;
+    int k;
+    for (;;) {
+        size_t room = s->cap - s->n;
+        va_start(ap, fmt);
+        k = vsnprintf(s->p ? s->p + s->n : NULL, s->p ? room : 0, fmt, ap);
+        va_end(ap);
+        if (k < 0)
+            return;
+        if (s->p && (size_t)k < room) {
+            s->n += (size_t)k;
+            return;
+        }
+        s->cap = (s->cap + (size_t)k + 1) * 2;
+        s->p = (char *)realloc(s->p, s->cap);
+        if (!s->p)
+            return;
+    }
+}
+
+static const char *reg_name(uint32_t r)
+{
+    static const char *n[16] = { "zr", "c0", "c1", "fogr", "v0", "v1", "zr", "zr",
+                                 "t0", "t1", "t2", "t3", "r0", "r1", "sumr", "efr" };
+    return n[r & 15];
+}
+
+/* An input byte as an RGB (vec3) or alpha (float) expression. */
+static void in_rgb(Str *s, uint32_t byte)
+{
+    const char *r = reg_name(byte & 0xF);
+    char src[48];
+    if (byte & 0x10)
+        snprintf(src, sizeof src, "vec3(%s.a)", r);
+    else
+        snprintf(src, sizeof src, "%s.rgb", r);
+    sa(s, "m%u(%s)", (byte >> 5) & 7, src);
+}
+
+static void in_alpha(Str *s, uint32_t byte)
+{
+    sa(s, "m%u(%s.%c)", (byte >> 5) & 7, reg_name(byte & 0xF), (byte & 0x10) ? 'a' : 'b');
+}
+
+static void out_map(uint32_t mapping, float *scale, float *bias)
+{
+    *scale = 1.0f; *bias = 0.0f;
+    switch (mapping) {
+    case 0x08: *bias = -0.5f; break;
+    case 0x10: *scale = 2.0f; break;
+    case 0x18: *bias = -0.5f; *scale = 2.0f; break;
+    case 0x20: *scale = 4.0f; break;
+    case 0x30: *scale = 0.5f; break;
+    default: break;
+    }
+}
+
+static char *gen_fs(const ProgKey *k)
+{
+    Str s = { NULL, 0, 0 };
+    uint32_t st, n = k->control & 0xFF, flags = k->control >> 8;
+    if (n > 8)
+        n = 8;
+
+    sa(&s, "#version 330\n");
+    sa(&s, "in vec4 vD0; in vec4 vD1; in vec4 vT0; in vec4 vT1; in vec4 vT2; in vec4 vT3; in float vFog;\n");
+    sa(&s, "out vec4 oColor;\n");
+    sa(&s, "uniform vec4 uC0[8]; uniform vec4 uC1[8]; uniform vec4 uFC0; uniform vec4 uFC1;\n");
+    sa(&s, "uniform vec3 uFog; uniform vec2 uAlpha; uniform vec2 uTexScale[4]; uniform vec4 uTexClamp[4];\n");
+    for (st = 0; st < 4; st++) {
+        if (!((k->tex_mask >> st) & 1))
+            continue;
+        if ((k->cube_mask >> st) & 1)
+            sa(&s, "uniform samplerCube uS%u;\n", st);
+        else
+            sa(&s, "uniform sampler2D uS%u;\n", st);
+    }
+    /* PS_INPUTMAPPING (nv2a_combiner.c map_in) */
+    sa(&s,
+       "vec3 m0(vec3 x){return max(x,0.0);} float m0(float x){return max(x,0.0);}\n"
+       "vec3 m1(vec3 x){return 1.0-clamp(x,0.0,1.0);} float m1(float x){return 1.0-clamp(x,0.0,1.0);}\n"
+       "vec3 m2(vec3 x){return 2.0*max(x,0.0)-1.0;} float m2(float x){return 2.0*max(x,0.0)-1.0;}\n"
+       "vec3 m3(vec3 x){return -2.0*max(x,0.0)+1.0;} float m3(float x){return -2.0*max(x,0.0)+1.0;}\n"
+       "vec3 m4(vec3 x){return max(x,0.0)-0.5;} float m4(float x){return max(x,0.0)-0.5;}\n"
+       "vec3 m5(vec3 x){return -max(x,0.0)+0.5;} float m5(float x){return -max(x,0.0)+0.5;}\n"
+       "vec3 m6(vec3 x){return x;} float m6(float x){return x;}\n"
+       "vec3 m7(vec3 x){return -x;} float m7(float x){return -x;}\n");
+    sa(&s, "bool atest(float a){ int v = int(a*255.0+0.5); int r = int(uAlpha.y); int f = int(uAlpha.x);\n"
+           " if (f==0x200) return false; if (f==0x201) return v<r; if (f==0x202) return v==r;\n"
+           " if (f==0x203) return v<=r; if (f==0x204) return v>r; if (f==0x205) return v!=r;\n"
+           " if (f==0x206) return v>=r; return true; }\n");
+    sa(&s, "void main() {\n");
+    sa(&s, "  vec4 zr = vec4(0.0);\n");
+    /* Texture stages (rc_stage_fetch). */
+    for (st = 0; st < 4; st++) {
+        uint32_t mode = k->stage_mode[st];
+        int has = (k->tex_mask >> st) & 1;
+        sa(&s, "  vec4 t%u = ", st);
+        if (!k->use_rc && st > 0) {
+            sa(&s, "vec4(0.0,0.0,0.0,1.0);\n");
+            continue;
+        }
+        switch (mode) {
+        case 1: case 2:
+            if (!has) { sa(&s, "vec4(1.0);\n"); break; }
+            if ((k->cube_mask >> st) & 1)
+                sa(&s, "texture(uS%u, vec3(vT%u.xy, 1.0));\n", st, st);
+            else
+                sa(&s, "texture(uS%u, clamp((vT%u.xy / (vT%u.w != 0.0 ? vT%u.w : 1.0)) * uTexScale[%u],"
+                       " uTexClamp[%u].xy, uTexClamp[%u].zw));\n", st, st, st, st, st, st, st);
+            break;
+        case 3:
+            if (!has) { sa(&s, "vec4(1.0);\n"); break; }
+            if ((k->cube_mask >> st) & 1)
+                sa(&s, "texture(uS%u, vT%u.xyz);\n", st, st);
+            else
+                sa(&s, "texture(uS%u, clamp(vT%u.xy * uTexScale[%u], uTexClamp[%u].xy, uTexClamp[%u].zw));\n",
+                   st, st, st, st, st);
+            break;
+        case 4:
+            sa(&s, "clamp(vT%u, 0.0, 1.0);\n", st);
+            break;
+        case 5: {
+            uint32_t j;
+            sa(&s, "vec4(0.0);\n");
+            for (j = 0; j < 4; j++) {
+                int ge = (k->clip_plane_mode >> (st * 4 + j)) & 1;
+                sa(&s, "  if (vT%u[%u] %s 0.0) discard;\n", st, j, ge ? ">=" : "<");
+            }
+            break;
+        }
+        case 0:
+            sa(&s, "vec4(0.0,0.0,0.0,1.0);\n");
+            break;
+        default:
+            sa(&s, "vec4(0.0);\n");
+            break;
+        }
+    }
+    if (!k->use_rc) {
+        if ((k->tex_mask & 1) && k->stage_mode[0])
+            sa(&s, "  vec4 o = %s;\n", k->modulate ? "t0 * vD0" : "t0");
+        else
+            sa(&s, "  vec4 o = vD0;\n");
+        sa(&s, "  o = clamp(o, 0.0, 1.0);\n");
+        sa(&s, "  if (!atest(o.a)) discard;\n  oColor = o;\n}\n");
+        return s.p;
+    }
+    sa(&s, "  vec4 v0 = vD0, v1 = vD1, fogr = vec4(uFog, vFog);\n");
+    sa(&s, "  vec4 r0 = vec4(0.0, 0.0, 0.0, %s), r1 = vec4(0.0), c0, c1, sumr = vec4(0.0), efr = vec4(0.0);\n",
+       (k->stage_mode[0] & 0x1F) ? "t0.a" : "1.0");
+    sa(&s, "  bool mux; vec3 A, B, C, D, pab, pcd, sm; float aA, aB, aC, aD, qab, qcd, qsm;\n");
+    for (st = 0; st < n; st++) {
+        uint32_t icw = k->color_icw[st], ocw = k->color_ocw[st];
+        uint32_t aicw = k->alpha_icw[st], aocw = k->alpha_ocw[st];
+        uint32_t fl = ocw >> 12, afl = aocw >> 12;
+        float os, ob, aos, aob;
+        out_map(fl & 0x38, &os, &ob);
+        out_map(afl & 0x38, &aos, &aob);
+        sa(&s, "  // stage %u\n  c0 = uC0[%u]; c1 = uC1[%u];\n", st, st, st);
+        if (flags & 1)
+            sa(&s, "  mux = r0.a >= 0.5;\n");
+        else
+            sa(&s, "  mux = (int(r0.a * 255.0) & 1) != 0;\n");
+        sa(&s, "  A = "); in_rgb(&s, icw >> 24); sa(&s, "; B = "); in_rgb(&s, icw >> 16);
+        sa(&s, "; C = "); in_rgb(&s, icw >> 8); sa(&s, "; D = "); in_rgb(&s, icw); sa(&s, ";\n");
+        sa(&s, "  aA = "); in_alpha(&s, aicw >> 24); sa(&s, "; aB = "); in_alpha(&s, aicw >> 16);
+        sa(&s, "; aC = "); in_alpha(&s, aicw >> 8); sa(&s, "; aD = "); in_alpha(&s, aicw); sa(&s, ";\n");
+        sa(&s, "  pab = %s; pcd = %s;\n", (fl & 2) ? "vec3(dot(A, B))" : "A * B",
+           (fl & 1) ? "vec3(dot(C, D))" : "C * D");
+        sa(&s, "  sm = %s;\n", (fl & 4) ? "(mux ? pcd : pab)" : "pab + pcd");
+        sa(&s, "  qab = aA * aB; qcd = aC * aD; qsm = %s;\n", (afl & 4) ? "(mux ? qcd : qab)" : "qab + qcd");
+        sa(&s, "  pab = clamp((pab + %.6f) * %.6f, -1.0, 1.0); pcd = clamp((pcd + %.6f) * %.6f, -1.0, 1.0);"
+               " sm = clamp((sm + %.6f) * %.6f, -1.0, 1.0);\n", ob, os, ob, os, ob, os);
+        sa(&s, "  qab = clamp((qab + %.6f) * %.6f, -1.0, 1.0); qcd = clamp((qcd + %.6f) * %.6f, -1.0, 1.0);"
+               " qsm = clamp((qsm + %.6f) * %.6f, -1.0, 1.0);\n", aob, aos, aob, aos, aob, aos);
+        if ((ocw >> 4) & 0xF) {
+            const char *d = reg_name((ocw >> 4) & 0xF);
+            if (((ocw >> 4) & 0xF) != 0)
+                sa(&s, "  %s.rgb = pab;%s\n", d, (fl & 0x80) ? "" : "");
+            if (fl & 0x80)
+                sa(&s, "  %s.a = pab.b;\n", d);
+        }
+        if (ocw & 0xF) {
+            const char *d = reg_name(ocw & 0xF);
+            sa(&s, "  %s.rgb = pcd;\n", d);
+            if (fl & 0x40)
+                sa(&s, "  %s.a = pcd.b;\n", d);
+        }
+        if ((ocw >> 8) & 0xF)
+            sa(&s, "  %s.rgb = sm;\n", reg_name((ocw >> 8) & 0xF));
+        if ((aocw >> 4) & 0xF) sa(&s, "  %s.a = qab;\n", reg_name((aocw >> 4) & 0xF));
+        if (aocw & 0xF)        sa(&s, "  %s.a = qcd;\n", reg_name(aocw & 0xF));
+        if ((aocw >> 8) & 0xF) sa(&s, "  %s.a = qsm;\n", reg_name((aocw >> 8) & 0xF));
+        sa(&s, "  zr = vec4(0.0);\n");
+    }
+    sa(&s, "  vec4 o;\n");
+    if (k->final0 || k->final1) {
+        uint32_t f0 = k->final0, f1 = k->final1, ff = f1 & 0xFF;
+        sa(&s, "  c0 = uFC0; c1 = uFC1;\n");
+        sa(&s, "  { vec3 a = %s, b = %s; sumr = vec4(%s, 0.0); }\n",
+           (ff & 0x40) ? "1.0 - v1.rgb" : "v1.rgb", (ff & 0x20) ? "1.0 - r0.rgb" : "r0.rgb",
+           (ff & 0x80) ? "clamp(a + b, 0.0, 1.0)" : "a + b");
+        sa(&s, "  { vec3 E = "); in_rgb(&s, f1 >> 24); sa(&s, ", F = "); in_rgb(&s, f1 >> 16);
+        sa(&s, "; efr = vec4(E * F, 0.0); }\n");
+        sa(&s, "  A = "); in_rgb(&s, f0 >> 24); sa(&s, "; B = "); in_rgb(&s, f0 >> 16);
+        sa(&s, "; C = "); in_rgb(&s, f0 >> 8); sa(&s, "; D = "); in_rgb(&s, f0); sa(&s, ";\n");
+        sa(&s, "  o.rgb = D + C * (1.0 - A) + B * A;\n  o.a = "); in_alpha(&s, f1 >> 8); sa(&s, ";\n");
+    } else {
+        sa(&s, "  o = r0;\n");
+    }
+    sa(&s, "  o = clamp(o, 0.0, 1.0);\n  if (!atest(o.a)) discard;\n  oColor = o;\n}\n");
+    return s.p;
+}
+
+/* ---- Vertex programs on the GPU ---------------------------------------
+ *
+ * The executor used to run every vertex program on the CPU, one thread,
+ * and hand over finished vertices: with three or four views drawn per
+ * frame that was most of a frame's time. A program can instead be written
+ * out as GLSL (nv2a_vsh_glsl) and run here, over the title's own vertex
+ * arrays: the executor copies the index range of each array as it is and
+ * the constants of each batch (a texture buffer, one block of 192 per
+ * batch, so batches that differ only in constants -- a character's
+ * 80-100 -- still go down as one draw). nvgl_draw_vsh. */
+#define NVGL_CONST_UNIT 4
+#define NVGL_VS_CACHE 512
+static struct { uint64_t id; GLuint sh; } s_vsc[NVGL_VS_CACHE];
+static const char *s_vs_pending_src;         /* source for the id being asked */
+
+static GLuint vs_shader(uint64_t id)
+{
+    uint32_t slot = (uint32_t)(id % NVGL_VS_CACHE), i;
+    for (i = 0; i < NVGL_VS_CACHE; i++) {
+        uint32_t j = (slot + i) % NVGL_VS_CACHE;
+        if (s_vsc[j].id == id)
+            return s_vsc[j].sh;
+        if (!s_vsc[j].id) {
+            GLuint sh;
+            if (!s_vs_pending_src)
+                return 0;
+            sh = gl_compile(GL_VERTEX_SHADER, s_vs_pending_src);
+            s_vsc[j].id = id;            /* a failure is remembered too */
+            s_vsc[j].sh = sh;
+            return sh;
+        }
+    }
+    return 0;
+}
+
+static GlProg *prog_get(const ProgKey *k)
+{
+    uint64_t h = hash_bytes((const uint8_t *)k, sizeof *k);
+    uint32_t slot = (uint32_t)(h % NVGL_PROGS), i;
+    GlProg *p = NULL;
+    for (i = 0; i < NVGL_PROGS; i++) {
+        GlProg *c = &s_prog[(slot + i) % NVGL_PROGS];
+        if (!c->used) { p = c; break; }
+        if (memcmp(&c->key, k, sizeof *k) == 0)
+            return c->prog ? c : NULL;
+    }
+    if (!p)
+        return NULL;
+    p->used = 1;
+    p->key = *k;
+    {
+        uint64_t t0 = xbox_HostNowNs();
+        char *src = gen_fs(k);
+        GLuint fs = src ? gl_compile(GL_FRAGMENT_SHADER, src) : 0;
+        GLint ok = 0;
+        free(src);
+        if (!fs)
+            return NULL;
+        p->prog = p_glCreateProgram();
+        p_glAttachShader(p->prog, k->vs ? vs_shader(k->vs) : s_vs);
+        p_glAttachShader(p->prog, fs);
+        p_glLinkProgram(p->prog);
+        p_glGetProgramiv(p->prog, GL_LINK_STATUS, &ok);
+        p_glDeleteShader(fs);
+        if (!ok) {
+            char log[2048];
+            p_glGetProgramInfoLog(p->prog, sizeof log, NULL, log);
+            fprintf(stderr, "[GPU-GL] link failed: %s\n", log);
+            p->prog = 0;
+            return NULL;
+        }
+        p_glUseProgram(p->prog);
+        p->uVp = p_glGetUniformLocation(p->prog, "uVp");
+        p->uC0 = p_glGetUniformLocation(p->prog, "uC0");
+        p->uC1 = p_glGetUniformLocation(p->prog, "uC1");
+        p->uFC0 = p_glGetUniformLocation(p->prog, "uFC0");
+        p->uFC1 = p_glGetUniformLocation(p->prog, "uFC1");
+        p->uFog = p_glGetUniformLocation(p->prog, "uFog");
+        p->uAlpha = p_glGetUniformLocation(p->prog, "uAlpha");
+        p->uTexScale = p_glGetUniformLocation(p->prog, "uTexScale");
+        p->uTexClamp = p_glGetUniformLocation(p->prog, "uTexClamp");
+        p->uCbBase = p_glGetUniformLocation(p->prog, "uCbBase");
+        p->uAa = p_glGetUniformLocation(p->prog, "uAa");
+        p->uFogP = p_glGetUniformLocation(p->prog, "uFogP");
+        if (k->vs)
+            p_glUniform1i(p_glGetUniformLocation(p->prog, "uConst"), NVGL_CONST_UNIT);
+        p->u_cb = -1;
+        memset(p->u_aa, 0xFF, sizeof p->u_aa);
+        memset(p->u_fp, 0xFF, sizeof p->u_fp);
+        memset(p->u_cl, 0, sizeof p->u_cl);       /* sent at the first draw */
+        for (i = 0; i < 4; i++) {
+            char nm[8];
+            snprintf(nm, sizeof nm, "uS%u", i);
+            p_glUniform1i(p_glGetUniformLocation(p->prog, nm), (GLint)i);
+        }
+        memset(p->u_vp, 0xFF, sizeof p->u_vp);
+        memset(p->u_sc, 0xFF, sizeof p->u_sc);
+        memset(p->u_al, 0xFF, sizeof p->u_al);
+        memset(p->u_cc, 0xFF, sizeof p->u_cc);
+        memset(p->u_f, 0xFF, sizeof p->u_f);
+        c.prog = p->prog;                 /* glUseProgram above */
+        s_stat.programs++;
+        {
+            uint64_t dt = xbox_HostNowNs() - t0;
+            s_stat.prog_ns += dt;
+            if (dt > s_stat.prog_max_ns)
+                s_stat.prog_max_ns = dt;
+        }
+        if (s_verbose)
+            fprintf(stderr, "[GPU-GL] program %llu: control %08X final %08X/%08X stages %X\n",
+                    (unsigned long long)s_stat.programs, k->control, k->final0, k->final1,
+                    k->stage_mode[0] | k->stage_mode[1] << 5 | k->stage_mode[2] << 10 | k->stage_mode[3] << 15);
+    }
+    return p;
+}
+
+static void unpack(uint32_t c, float o[4])
+{
+    o[0] = (float)((c >> 16) & 0xFF) / 255.0f;
+    o[1] = (float)((c >> 8) & 0xFF) / 255.0f;
+    o[2] = (float)(c & 0xFF) / 255.0f;
+    o[3] = (float)(c >> 24) / 255.0f;
+}
+
+/* ---- Drawing --------------------------------------------------------- */
+
+static GLenum blend_eq(uint32_t e)
+{
+    switch (e) {
+    case 0x8006: case 0x800A: case 0x800B: case 0x8007: case 0x8008:
+        return e;
+    case 0xF005: return 0x800B;    /* REVERSE_SUBTRACT_SIGNED */
+    case 0xF006: return 0x8006;    /* ADD_SIGNED */
+    default: return GL_FUNC_ADD;
+    }
+}
+
+/* An address mode that clamps (clamp, border, clamp-to-edge). */
+static int t_clamped(uint32_t a)
+{
+    return a != 1 && a != 2;
+}
+
+static GlSurf *draw_begin(const NvGlSurface *d, const NvGlState *st,
+                          const NvGlTexture *const tex[4], uint64_t vs, GlProg **out)
+{
+    const Nv2aRenderState *rs = &st->rs;
+    ProgKey k;
+    GlProg *p;
+    GlSurf *s;
+    uint32_t i;
+    float sscale[4][2];
+    float sclamp[4][4];
+    int use_depth = st->depth && (rs->depth_test_enable || rs->depth_write || rs->stencil_enable);
+
+    if (s_state <= 0)
+        return NULL;
+    {
+        /* Tests: RECOMP_SKIP_TEX=<hex address>: draws whose first texture
+         * is there are not drawn. */
+        static long skip = -2;
+        if (skip == -2) {
+            const char *e = getenv("RECOMP_SKIP_TEX");
+            skip = e ? strtol(e, NULL, 16) : -1;
+        }
+        if (skip >= 0 && tex[0] && tex[0]->lo == (uint32_t)skip)
+            return NULL;
+    }
+    memset(&k, 0, sizeof k);
+    k.vs = vs;
+    k.use_rc = (uint32_t)st->use_rc;
+    k.modulate = (uint32_t)st->modulate;
+    k.clip_plane_mode = st->clip_plane_mode;
+    for (i = 0; i < 4; i++) {
+        k.stage_mode[i] = st->stage_mode[i] & 0x1F;
+        if (tex[i]) {
+            k.tex_mask |= 1u << i;
+            if (tex[i]->cube)
+                k.cube_mask |= 1u << i;
+        }
+    }
+    if (st->use_rc) {
+        uint32_t n = st->rc.control & 0xFF;
+        if (n > 8) n = 8;
+        k.control = st->rc.control;
+        k.final0 = st->rc.final0;
+        k.final1 = st->rc.final1;
+        for (i = 0; i < n; i++) {
+            k.color_icw[i] = st->rc.color_icw[i];
+            k.alpha_icw[i] = st->rc.alpha_icw[i];
+            k.color_ocw[i] = st->rc.color_ocw[i];
+            k.alpha_ocw[i] = st->rc.alpha_ocw[i];
+        }
+    }
+    p = prog_get(&k);
+    if (!p)
+        return NULL;
+
+    /* Textures before the target: sampling a surface the GPU drew into
+     * reads it back first, which binds another framebuffer. */
+    for (i = 0; i < 4; i++) {
+        if (!tex[i] || tex[i]->from_surface || !k.stage_mode[i] || (!st->use_rc && i > 0))
+            continue;
+        nvgl_sync_range(tex[i]->lo, tex[i]->hi);
+    }
+    s = bind_target(d, use_depth);
+    if (!s)
+        return NULL;
+    for (i = 0; i < 4; i++) {
+        GlSurf *src;
+        sscale[i][0] = sscale[i][1] = 0.0f;
+        sclamp[i][0] = sclamp[i][1] = -1e9f;
+        sclamp[i][2] = sclamp[i][3] = 1e9f;
+        if (!tex[i] || !k.stage_mode[i] || (!st->use_rc && i > 0)) {
+            c_texture((int)i, GL_TEXTURE_2D, s_white2d);
+            continue;
+        }
+        if (tex[i]->from_surface) {
+            src = surf_backing(tex[i]->surf_va, tex[i]->surf_pitch, tex[i]->surf_bpp,
+                               tex[i]->surf_swz, tex[i]->width, tex[i]->height, 0);
+            if (!src) {
+                c_texture((int)i, GL_TEXTURE_2D, s_white2d);
+                continue;
+            }
+            if (src == s) {
+                /* The stage reads the surface this draw writes (a
+                 * full-screen colour pass over the back buffer). GL leaves
+                 * that undefined -- on NVIDIA it comes out as blocks of
+                 * stale tiles -- so the stage reads a copy taken now, which
+                 * is what the NV2A's own read-before-write amounts to. */
+                static int skip = -1;
+                if (skip < 0)
+                    skip = getenv("RECOMP_SKIP_FEEDBACK") != NULL;
+                if (skip)
+                    return NULL;            /* tests: drop full-screen passes */
+                surf_sample_bind((int)i, feedback_copy(s), tex[i]);
+            } else {
+                surf_sample_bind((int)i, src, tex[i]);
+            }
+            if (tex[i]->linear) {
+                sscale[i][0] = 1.0f / (float)src->w;
+                sscale[i][1] = 1.0f / (float)src->h;
+            }
+            /* A surface drawn at the render scale, clamped: keep samples
+             * inside the centres of its outermost guest texels, as at 1x.
+             * Beyond them lie rows the title's own drawing covers only at
+             * 1x (the front end's book pages are drawn into a 512x256
+             * surface; their top row came out as a grey line along every
+             * page's edge at 2x and up). */
+            if (src->gw > src->w || src->gh > src->h) {
+                float tw = (float)tex[i]->width, th = (float)tex[i]->height;
+                if (tw > 0 && th > 0) {
+                    /* Inset by the outermost guest texel and a half: that
+                     * row of the book pages' surface is grey (the paper
+                     * drawn into it wraps there), sharp at a higher scale. */
+                    if (t_clamped(tex[i]->addr_u)) {
+                        sclamp[i][0] = 1.5f / tw;
+                        sclamp[i][2] = 1.0f - 1.5f / tw;
+                    }
+                    if (t_clamped(tex[i]->addr_v)) {
+                        sclamp[i][1] = 1.5f / th;
+                        sclamp[i][3] = 1.0f - 1.5f / th;
+                    }
+                }
+            }
+            s_stat.direct++;
+            continue;
+        }
+        tex_bind(tex[i], (int)i);
+    }
+
+    c_validate();
+    c_program(p->prog);
+    {
+        float vp[4], sc[4][2], al[2];
+        vp[0] = 2.0f / (float)s->w;
+        vp[1] = 2.0f / (float)s->h;
+        vp[2] = st->zmax > 0.0f ? 1.0f / st->zmax : 1.0f;
+        vp[3] = 0.0f;
+        if (memcmp(vp, p->u_vp, sizeof vp)) {
+            p_glUniform4fv(p->uVp, 1, vp);
+            memcpy(p->u_vp, vp, sizeof vp);
+        }
+        for (i = 0; i < 4; i++) {
+            sc[i][0] = sc[i][1] = 1.0f;
+            if (sscale[i][0] != 0.0f) {
+                sc[i][0] = sscale[i][0];
+                sc[i][1] = sscale[i][1];
+            } else if (tex[i] && tex[i]->linear && tex[i]->width && tex[i]->height) {
+                sc[i][0] = 1.0f / (float)tex[i]->width;
+                sc[i][1] = 1.0f / (float)tex[i]->height;
+            }
+        }
+        if (memcmp(sc, p->u_sc, sizeof sc)) {
+            p_glUniform2fv(p->uTexScale, 4, &sc[0][0]);
+            memcpy(p->u_sc, sc, sizeof sc);
+        }
+        if (memcmp(sclamp, p->u_cl, sizeof sclamp)) {
+            p_glUniform4fv(p->uTexClamp, 4, &sclamp[0][0]);
+            memcpy(p->u_cl, sclamp, sizeof sclamp);
+        }
+        al[0] = rs->alpha_test_enable ? (float)rs->alpha_func : (float)GL_ALWAYS;
+        al[1] = (float)(rs->alpha_ref & 0xFF);
+        if (memcmp(al, p->u_al, sizeof al)) {
+            p_glUniform2fv(p->uAlpha, 1, al);
+            memcpy(p->u_al, al, sizeof al);
+        }
+    }
+    if (st->use_rc) {
+        float cc[2][8][4], f[3][4];
+        uint32_t flags = st->rc.control >> 8, n = st->rc.control & 0xFF;
+        if (n > 8) n = 8;
+        memset(cc, 0, sizeof cc);
+        for (i = 0; i < n; i++) {
+            unpack(st->rc.factor0[(flags & 0x010) ? i : 0], cc[0][i]);
+            unpack(st->rc.factor1[(flags & 0x100) ? i : 0], cc[1][i]);
+        }
+        if (memcmp(cc, p->u_cc, sizeof cc)) {
+            p_glUniform4fv(p->uC0, 8, &cc[0][0][0]);
+            p_glUniform4fv(p->uC1, 8, &cc[1][0][0]);
+            memcpy(p->u_cc, cc, sizeof cc);
+        }
+        unpack(st->rc.final_c0, f[0]);
+        unpack(st->rc.final_c1, f[1]);
+        f[2][0] = st->fog_color[0]; f[2][1] = st->fog_color[1];
+        f[2][2] = st->fog_color[2]; f[2][3] = 0.0f;
+        if (memcmp(f, p->u_f, sizeof f)) {
+            p_glUniform4fv(p->uFC0, 1, f[0]);
+            p_glUniform4fv(p->uFC1, 1, f[1]);
+            p_glUniform3f(p->uFog, f[2][0], f[2][1], f[2][2]);
+            memcpy(p->u_f, f, sizeof f);
+        }
+    }
+
+    /* Fixed-function state. */
+    set_scissor(d, s, d->clip_x, d->clip_y, d->clip_x + d->clip_w, d->clip_y + d->clip_h);
+    c_cap(GL_BLEND, &c.blend, rs->blend_enable != 0);
+    if (rs->blend_enable) {
+        GLenum eq = blend_eq(rs->blend_eq);
+        if (c.bsrc != rs->blend_src || c.bdst != rs->blend_dst) {
+            p_glBlendFunc(rs->blend_src, rs->blend_dst);
+            c.bsrc = rs->blend_src;
+            c.bdst = rs->blend_dst;
+        }
+        if (c.beq != eq) {
+            p_glBlendEquation(eq);
+            c.beq = eq;
+        }
+        if (c.bcolor != rs->blend_color) {
+            p_glBlendColor((float)((rs->blend_color >> 16) & 0xFF) / 255.0f,
+                           (float)((rs->blend_color >> 8) & 0xFF) / 255.0f,
+                           (float)(rs->blend_color & 0xFF) / 255.0f,
+                           (float)(rs->blend_color >> 24) / 255.0f);
+            c.bcolor = rs->blend_color;
+        }
+    }
+    c_colormask(((rs->color_mask & 0x00010000u) ? 1u : 0u) | ((rs->color_mask & 0x00000100u) ? 2u : 0u)
+                | ((rs->color_mask & 0x00000001u) ? 4u : 0u) | ((rs->color_mask & 0x01000000u) ? 8u : 0u));
+    c_cap(GL_DEPTH_TEST, &c.depth, use_depth);
+    if (use_depth) {
+        GLenum df = rs->depth_test_enable ? rs->depth_func : GL_ALWAYS;
+        if (c.dfunc != df) {
+            p_glDepthFunc(df);
+            c.dfunc = df;
+        }
+        c_depthmask(rs->depth_write != 0);
+    }
+    c_cap(GL_STENCIL_TEST, &c.stencil, use_depth && rs->stencil_enable);
+    if (use_depth && rs->stencil_enable) {
+        if (c.sfunc != rs->stencil_func || c.sref != (GLint)(rs->stencil_ref & 0xFF)
+            || c.smask != (rs->stencil_func_mask & 0xFF)) {
+            p_glStencilFunc(rs->stencil_func, (GLint)(rs->stencil_ref & 0xFF),
+                            rs->stencil_func_mask & 0xFF);
+            c.sfunc = rs->stencil_func;
+            c.sref = (GLint)(rs->stencil_ref & 0xFF);
+            c.smask = rs->stencil_func_mask & 0xFF;
+        }
+        if (c.sfail != rs->stencil_fail || c.szfail != rs->stencil_zfail
+            || c.szpass != rs->stencil_zpass) {
+            p_glStencilOp(rs->stencil_fail, rs->stencil_zfail, rs->stencil_zpass);
+            c.sfail = rs->stencil_fail;
+            c.szfail = rs->stencil_zfail;
+            c.szpass = rs->stencil_zpass;
+        }
+        c_stencilmask(rs->stencil_write_mask & 0xFF);
+    }
+
+    *out = p;
+    return s;
+}
+
+void nvgl_draw(const NvGlSurface *d, const NvGlState *st,
+               const NvGlTexture *const tex[4], const NvGlVertex *v,
+               uint32_t count)
+{
+    const Nv2aRenderState *rs = &st->rs;
+    GlProg *p;
+    GlSurf *s;
+    int use_depth = st->depth && (rs->depth_test_enable || rs->depth_write || rs->stencil_enable);
+
+    if (s_state <= 0 || count < 3)
+        return;
+    s = draw_begin(d, st, tex, 0, &p);
+    if (!s)
+        return;
+    (void)p;
+    /* Vertices into a ring buffer, orphaned when full. */
+    {
+        size_t bytes = (size_t)count * sizeof *v;
+        if (bytes > NVGL_VB_BYTES) {
+            p_glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)bytes, v, GL_STREAM_DRAW);
+            p_glDrawArrays(GL_TRIANGLES, 0, (GLsizei)count);
+            p_glBufferData(GL_ARRAY_BUFFER, NVGL_VB_BYTES, NULL, GL_STREAM_DRAW);
+            s_vb_off = 0;
+        } else {
+            if (s_vb_off + bytes > NVGL_VB_BYTES) {
+                p_glBufferData(GL_ARRAY_BUFFER, NVGL_VB_BYTES, NULL, GL_STREAM_DRAW);
+                s_vb_off = 0;
+            }
+            p_glBufferSubData(GL_ARRAY_BUFFER, (GLintptr)s_vb_off, (GLsizeiptr)bytes, v);
+            p_glDrawArrays(GL_TRIANGLES, (GLint)(s_vb_off / sizeof *v), (GLsizei)count);
+            s_vb_off += bytes;
+        }
+    }
+    if (rs->color_mask & 0x01010101u)
+        s->dirty = 1;
+    {
+        /* RECOMP_PIXEL_PROBE=x,y (guest pixels) with RECOMP_PIXEL_PROBE_FLAG
+         * =<file>: for the frame after the file appears, every draw that
+         * changes that pixel of the surface it draws into is logged, with
+         * its state -- to find which draw puts a stray pixel there. */
+        static int px = -2, py, frame = -1, n, inner, all;
+        static uint32_t last[NVGL_SURFS];
+        if (px == -2) {
+            const char *e = getenv("RECOMP_PIXEL_PROBE");
+            px = -1;
+            if (e && sscanf(e, "%d,%d", &px, &py) != 2)
+                px = -1;
+        }
+        if (px >= 0) {
+            const char *flag = getenv("RECOMP_PIXEL_PROBE_FLAG");
+            if (frame < 0 && flag && s_frame % 30 == 0) {
+                FILE *f = fopen(flag, "rb");
+                if (f) {
+                    int a, b;
+                    char w[8] = "";
+                    /* "x y [all]" in the flag file: a pixel of the scaled
+                     * surface; "all": every change of it, either way. */
+                    inner = fscanf(f, "%d %d %7s", &a, &b, w) >= 2;
+                    all = !strcmp(w, "all");
+                    if (inner) { px = a; py = b; }
+                    fclose(f); remove(flag); frame = (int)s_frame + 1; n = 0;
+                    memset(last, 0, sizeof last);
+                }
+            }
+            if (frame >= 0 && (int)s_frame == frame
+                && (uint32_t)px < (inner ? s->gw : s->w) && (uint32_t)py < (inner ? s->gh : s->h)) {
+                /* A column of 15 pixels around it: a draw that turns one
+                 * of them from dark to light is logged (the camera of a
+                 * menu sways, so one pixel is a moving target). */
+                static uint8_t col[NVGL_SURFS][15][4];
+                uint8_t now[15][4];
+                int sx = inner ? px : (int)((px + 0.5f) * s->gw / s->w);
+                int sy = inner ? py : (int)((py + 0.5f) * s->gh / s->h);
+                uint32_t slot = (uint32_t)(s - s_surf), j;
+                if (sy >= 7 && sy + 7 < (int)s->gh && slot < NVGL_SURFS) {
+                    p_glReadPixels(sx, sy - 7, 1, 15, GL_RGBA, GL_UNSIGNED_BYTE, now);
+                    for (j = 0; j < 15; j++) {
+                        int lo = col[slot][j][0] + col[slot][j][1] + col[slot][j][2];
+                        int hi = now[j][0] + now[j][1] + now[j][2];
+                        if ((all ? (j == 7 && (hi - lo > 30 || lo - hi > 30))
+                                 : hi - lo > 3 * 30) && n < 300) {
+                            n++;
+                            fprintf(stderr, "  [PROBE] draw %u surf 0x%08X: row %d %02X%02X%02X -> %02X%02X%02X | %u verts, "
+                                    "tex0 %ux%u at %08X%s lin %d addr %u/%u filter %08X, tex1 %ux%u, depth %d func 0x%X "
+                                    "write %d, blend %d alphatest %d ref %u, cull %d\n",
+                                    (unsigned)s_stat.draws, s->va, sy - 7 + (int)j,
+                                    col[slot][j][0], col[slot][j][1], col[slot][j][2],
+                                    now[j][0], now[j][1], now[j][2], count,
+                                    tex[0] ? tex[0]->width : 0, tex[0] ? tex[0]->height : 0,
+                                    tex[0] ? tex[0]->lo : 0,
+                                    tex[0] && tex[0]->from_surface ? " (surface)" : "",
+                                    tex[0] ? (int)tex[0]->linear : -1,
+                                    tex[0] ? tex[0]->addr_u : 0, tex[0] ? tex[0]->addr_v : 0,
+                                    tex[0] ? tex[0]->filter : 0,
+                                    tex[1] ? tex[1]->width : 0, tex[1] ? tex[1]->height : 0,
+                                    use_depth, rs->depth_test_enable ? (unsigned)rs->depth_func : 0,
+                                    rs->depth_write != 0, rs->blend_enable != 0,
+                                    rs->alpha_test_enable != 0, (unsigned)(rs->alpha_ref & 0xFF),
+                                    rs->cull_enable != 0);
+                            fflush(stderr);
+                        }
+                    }
+                    memcpy(col[slot], now, sizeof now);
+                }
+            }
+            if (frame >= 0 && (int)s_frame > frame)
+                frame = -1;
+        }
+    }
+    s_stat.draws++;
+    s_stat.tris += count / 3;
+    if (s_verbose) {
+        GLenum e = p_glGetError();
+        if (e != GL_NO_ERROR)
+            fprintf(stderr, "[GPU-GL] GL error 0x%X after draw\n", e);
+    }
+}
+
+/* ---- Vertex programs on the GPU: shaders and draws -------------------- */
+
+static uint64_t vsh_shader_id(const NvGlVshLayout *L)
+{
+    uint64_t h = L->program * 0x9E3779B97F4A7C15ull ^ (uint64_t)(L->cb_loc + 1);
+    int i;
+    for (i = 0; i < 16; i++) {
+        const NvGlVshInput *in = &L->in[i];
+        uint32_t k = in->used ? (uint32_t)in->type << 8 | in->size : 0u;
+        /* Only what changes the declarations: CMP and S1 are unpacked in
+         * the shader, everything else arrives as a vec4. */
+        if (in->used && in->type != 6 && in->type != 1)
+            k = 0x100000u;
+        h = (h ^ ((uint64_t)k << 5 | (uint64_t)i)) * 1099511628211ull;
+    }
+    return h ? h : 1;
+}
+
+static char *vsh_source(const NvGlVshLayout *L, const char *body)
+{
+    Str g = {NULL, 0, 0};
+    int i;
+    sa(&g, "#version 330\n");
+    for (i = 0; i < 16; i++) {
+        const NvGlVshInput *in = &L->in[i];
+        if (!in->used)
+            continue;
+        if (in->type == 6)
+            sa(&g, "layout(location=%d) in uint v%dr;\n", i, i);
+        else if (in->type == 1)
+            sa(&g, "layout(location=%d) in vec4 v%ds;\n", i, i);
+        else
+            sa(&g, "layout(location=%d) in vec4 v%d;\n", i, i);
+    }
+    sa(&g, "layout(location=%d) in float aCb;\n", L->cb_loc);
+    sa(&g, "uniform samplerBuffer uConst; uniform int uCbBase;\n"
+           "uniform vec4 uVp; uniform vec4 uAa; uniform vec4 uFogP;\n"
+           "out vec4 vD0; out vec4 vD1; out vec4 vT0; out vec4 vT1; out vec4 vT2; out vec4 vT3;\n"
+           "out float vFog;\n"
+           "out float gl_ClipDistance[2];\n"
+           "int gBase;\n"
+           "vec4 C(int i) { return texelFetch(uConst, gBase + i); }\n"
+           "vec4 CRf(int j) { if (j < 0 || j >= 192) j = 0; return texelFetch(uConst, gBase + j); }\n"
+           "#define CR(i) CRf((i) + a0)\n"
+           "float fmn(float a, float b) { return a < b ? a : b; }\n"
+           "float fmx(float a, float b) { return a >= b ? a : b; }\n"
+           "vec4 vmin(vec4 a, vec4 b) { return vec4(fmn(a.x,b.x), fmn(a.y,b.y), fmn(a.z,b.z), fmn(a.w,b.w)); }\n"
+           "vec4 vmax(vec4 a, vec4 b) { return vec4(fmx(a.x,b.x), fmx(a.y,b.y), fmx(a.z,b.z), fmx(a.w,b.w)); }\n"
+           "vec4 vslt(vec4 a, vec4 b) { return vec4(a.x<b.x?1.0:0.0, a.y<b.y?1.0:0.0, a.z<b.z?1.0:0.0, a.w<b.w?1.0:0.0); }\n"
+           "vec4 vsge(vec4 a, vec4 b) { return vec4(a.x>=b.x?1.0:0.0, a.y>=b.y?1.0:0.0, a.z>=b.z?1.0:0.0, a.w>=b.w?1.0:0.0); }\n"
+           "float rcc(float x) { float f = 1.0 / x;\n"
+           "  if (abs(f) < 5.42101e-20) f = f < 0.0 ? -5.42101e-20 : 5.42101e-20;\n"
+           "  if (abs(f) > 1.884467e19) f = f < 0.0 ? -1.884467e19 : 1.884467e19;\n"
+           "  return f; }\n"
+           "vec4 iexp(float x) { float fl = floor(x); return vec4(exp2(fl), x - fl, exp2(x), 1.0); }\n"
+           "vec4 ilog(float x) { float ax = abs(x);\n"
+           "  if (ax == 0.0) { float ni = uintBitsToFloat(0xFF800000u); return vec4(ni, 1.0, ni, 1.0); }\n"
+           "  float e = floor(log2(ax)); return vec4(e, ax / exp2(e), log2(ax), 1.0); }\n"
+           "vec4 ilit(vec4 c) { float nl = c.x > 0.0 ? c.x : 0.0, nh = c.y > 0.0 ? c.y : 0.0;\n"
+           "  float p = c.w < -127.9961 ? -127.9961 : (c.w > 127.9961 ? 127.9961 : c.w);\n"
+           "  float sp = nh == 0.0 ? (p == 0.0 ? 1.0 : (p > 0.0 ? 0.0 : uintBitsToFloat(0x7F800000u))) : pow(nh, p);\n"
+           "  return vec4(1.0, nl, c.x > 0.0 ? sp : 0.0, 1.0); }\n"
+           "float sat1(float c) { return c > 1.0 ? 1.0 : (c >= 0.0 ? c : 0.0); }\n"
+           "vec4 sat(vec4 c) { return vec4(sat1(c.x), sat1(c.y), sat1(c.z), sat1(c.w)); }\n"
+           "float fogf(float d) { if (uFogP.x == 0.0) return 1.0;\n"
+           "  int m = int(uFogP.y); float px = uFogP.z, py = uFogP.w, f;\n"
+           "  if (m == 0x800 || m == 0x802) f = px + exp2(d * py * 16.0) - 1.5;\n"
+           "  else if (m == 0x801 || m == 0x803) f = px + exp2(-d * d * py * py * 32.0) - 1.5;\n"
+           "  else f = px + d * py - 1.0;\n"
+           "  if (m == 0x802 || m == 0x803 || m == 0x804) f = abs(f);\n"
+           "  if (isnan(f)) f = 1.0;\n"
+           "  return f < 0.0 ? 0.0 : (f > 1.0 ? 1.0 : f); }\n"
+           "float s11(uint x, uint sb, float full, float sc) { float v = float(x); if ((x & sb) != 0u) v -= full; return v / sc; }\n"
+           "void main() {\n"
+           "  gBase = (uCbBase + int(aCb + 0.5)) * 192;\n");
+    for (i = 0; i < 16; i++) {
+        const NvGlVshInput *in = &L->in[i];
+        if (!in->used)
+            continue;
+        if (in->type == 6)
+            sa(&g, "  vec4 v%d = vec4(s11(v%dr & 0x7FFu, 0x400u, 2048.0, 1023.0),"
+                   " s11((v%dr >> 11) & 0x7FFu, 0x400u, 2048.0, 1023.0),"
+                   " s11(v%dr >> 22, 0x200u, 1024.0, 511.0), 1.0);\n", i, i, i, i);
+        else if (in->type == 1) {
+            char comp[4][40];
+            int c2;
+            for (c2 = 0; c2 < 4; c2++) {
+                if (c2 < in->size)
+                    snprintf(comp[c2], sizeof comp[c2], "v%ds.%c / 32767.0", i, "xyzw"[c2]);
+                else
+                    snprintf(comp[c2], sizeof comp[c2], "%s", c2 == 3 ? "1.0" : "0.0");
+            }
+            sa(&g, "  vec4 v%d = vec4(%s, %s, %s, %s);\n", i, comp[0], comp[1], comp[2], comp[3]);
+        }
+    }
+    sa(&g, "  vec4 oPos = vec4(0.0), oFog = vec4(0.0);\n"
+           "  vec4 oD0 = vec4(0.0, 0.0, 0.0, 1.0), oD1 = oD0, oT0 = oD0, oT1 = oD0, oT2 = oD0, oT3 = oD0;\n");
+    sa(&g, "%s", body);
+    sa(&g, "  vec4 P = oPos;\n"
+           "  if (floatBitsToUint(P.w) == 0u) P.w = 1.0;\n"
+           "  P.x *= uAa.x; P.y *= uAa.y;\n"
+           "  float w = P.w;\n"
+           "  gl_Position = vec4(P.x * uVp.x - 1.0, P.y * uVp.y - 1.0, P.z * uVp.z * 2.0 - 1.0, 1.0) * w;\n"
+           "  gl_ClipDistance[0] = w - 1e-3;\n"
+           "  gl_ClipDistance[1] = (P.z - uAa.z) * w;\n"
+           /* A vertex the program left at NaN, infinity or absurdly far
+            * off (a skinned model whose bones are not set up: spawned
+            * characters, user video -- white streaks across the screen):
+            * cut away, its triangles shrunk to their other corners. */
+           "  if (any(isnan(P)) || any(isinf(P)) || abs(P.x) > 1e6 * abs(w) + 1e6 || abs(P.y) > 1e6 * abs(w) + 1e6) {\n"
+           "    gl_Position = vec4(0.0, 0.0, 0.0, 1.0);\n"
+           "    gl_ClipDistance[0] = -1e30; gl_ClipDistance[1] = -1e30;\n"
+           "  }\n"
+           "  vD0 = sat(oD0); vD1 = sat(oD1);\n"
+           "  vT0 = oT0; vT1 = oT1; vT2 = oT2; vT3 = oT3;\n"
+           "  vFog = fogf(oFog.x);\n"
+           "}\n");
+    return g.p;
+}
+
+uint64_t nvgl_vsh_prepare(const NvGlVshLayout *L, char *(*body)(void))
+{
+    uint64_t id;
+    uint32_t slot, i;
+    if (s_state <= 0 || !L->program)
+        return 0;
+    id = vsh_shader_id(L);
+    slot = (uint32_t)(id % NVGL_VS_CACHE);
+    for (i = 0; i < NVGL_VS_CACHE; i++) {
+        uint32_t j = (slot + i) % NVGL_VS_CACHE;
+        if (s_vsc[j].id == id)
+            return s_vsc[j].sh ? id : 0;
+        if (!s_vsc[j].id)
+            break;
+    }
+    if (i == NVGL_VS_CACHE)
+        return 0;                                 /* cache full */
+    {
+        char *b = body(), *src;
+        GLuint sh;
+        if (!b)
+            return 0;
+        src = vsh_source(L, b);
+        free(b);
+        if (!src)
+            return 0;
+        if (getenv("RECOMP_VSH_GLSL_DUMP")) {
+            static int shown;
+            if (shown++ < 4)
+                fprintf(stderr, "[GPU-GL] vertex program %016llX as GLSL:\n%s\n",
+                        (unsigned long long)id, src);
+        }
+        s_vs_pending_src = src;
+        sh = vs_shader(id);
+        s_vs_pending_src = NULL;
+        free(src);
+        if (s_verbose || !sh)
+            fprintf(stderr, "[GPU-GL] vertex program %016llX: %s\n",
+                    (unsigned long long)id, sh ? "on the GPU" : "GLSL failed, CPU");
+        return sh ? id : 0;
+    }
+}
+
+#define NVGL_VS_VB_BYTES ((size_t)32 << 20)
+#define NVGL_VS_IB_BYTES ((size_t)8 << 20)
+#define NVGL_VS_CB_BYTES ((size_t)24 << 20)
+static GLuint s_vs_vao, s_vs_vbo, s_vs_ibo, s_vs_cbo, s_vs_cbtex;
+static size_t s_vs_voff, s_vs_ioff, s_vs_coff;
+static uint32_t s_vs_enabled;                /* attribute arrays on in s_vs_vao */
+
+static size_t ring_put(GLenum target, size_t *off, size_t cap, size_t align,
+                       const void *data, size_t bytes)
+{
+    size_t at = (*off + align - 1) / align * align;
+    if (at + bytes > cap) {
+        p_glBufferData(target, (GLsizeiptr)cap, NULL, GL_STREAM_DRAW);
+        at = 0;
+    }
+    p_glBufferSubData(target, (GLintptr)at, (GLsizeiptr)bytes, data);
+    *off = at + bytes;
+    return at;
+}
+
+void nvgl_draw_vsh(const NvGlSurface *d, const NvGlState *st,
+                   const NvGlTexture *const tex[4], uint64_t vs,
+                   const NvGlVshLayout *L, const uint8_t *const data[5],
+                   uint32_t nverts, const uint32_t *idx, uint32_t nidx,
+                   const float *consts, uint32_t nblocks)
+{
+    const Nv2aRenderState *rs = &st->rs;
+    GlProg *p;
+    GlSurf *s;
+    size_t base[5], at;
+    uint32_t i, want = 0;
+    int cb;
+
+    if (s_state <= 0 || nidx < 3 || !nverts || !nblocks || !vs)
+        return;
+    if ((size_t)nblocks * 3072 > NVGL_VS_CB_BYTES
+        || (size_t)nidx * 4 > NVGL_VS_IB_BYTES)
+        return;
+    s = draw_begin(d, st, tex, vs, &p);
+    if (!s)
+        return;
+    if (!s_vs_vao) {
+        p_glGenVertexArrays(1, &s_vs_vao);
+        p_glGenBuffers(1, &s_vs_vbo);
+        p_glGenBuffers(1, &s_vs_ibo);
+        p_glGenBuffers(1, &s_vs_cbo);
+        p_glGenTextures(1, &s_vs_cbtex);
+        p_glBindVertexArray(s_vs_vao);
+        p_glBindBuffer(GL_ARRAY_BUFFER, s_vs_vbo);
+        p_glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)NVGL_VS_VB_BYTES, NULL, GL_STREAM_DRAW);
+        p_glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, s_vs_ibo);
+        p_glBufferData(GL_ELEMENT_ARRAY_BUFFER, (GLsizeiptr)NVGL_VS_IB_BYTES, NULL, GL_STREAM_DRAW);
+        p_glBindBuffer(GL_TEXTURE_BUFFER, s_vs_cbo);
+        p_glBufferData(GL_TEXTURE_BUFFER, (GLsizeiptr)NVGL_VS_CB_BYTES, NULL, GL_STREAM_DRAW);
+        c_texture(NVGL_CONST_UNIT, GL_TEXTURE_BUFFER, s_vs_cbtex);
+        p_glTexBuffer(GL_TEXTURE_BUFFER, GL_RGBA32F, s_vs_cbo);
+        s_vs_enabled = 0;
+    }
+    /* The constants. */
+    p_glBindBuffer(GL_TEXTURE_BUFFER, s_vs_cbo);
+    at = ring_put(GL_TEXTURE_BUFFER, &s_vs_coff, NVGL_VS_CB_BYTES, 3072,
+                  consts, (size_t)nblocks * 3072);
+    cb = (int)(at / 3072);
+    c_texture(NVGL_CONST_UNIT, GL_TEXTURE_BUFFER, s_vs_cbtex);
+    if (p->u_cb != cb) {
+        p_glUniform1i(p->uCbBase, cb);
+        p->u_cb = cb;
+    }
+    if (memcmp(p->u_aa, L->aa, sizeof p->u_aa)) {
+        p_glUniform4fv(p->uAa, 1, L->aa);
+        memcpy(p->u_aa, L->aa, sizeof p->u_aa);
+    }
+    if (memcmp(p->u_fp, L->fog, sizeof p->u_fp)) {
+        p_glUniform4fv(p->uFogP, 1, L->fog);
+        memcpy(p->u_fp, L->fog, sizeof p->u_fp);
+    }
+    /* The vertices: each stream into the ring, then the attributes on it. */
+    p_glBindVertexArray(s_vs_vao);
+    p_glBindBuffer(GL_ARRAY_BUFFER, s_vs_vbo);
+    for (i = 0; i < 5; i++) {
+        size_t bytes = (size_t)nverts * L->stride[i];
+        base[i] = 0;
+        if (!L->stride[i] || !data[i])
+            continue;
+        if (bytes > NVGL_VS_VB_BYTES / 2) {
+            p_glBindVertexArray(s_vao);
+            p_glBindBuffer(GL_ARRAY_BUFFER, s_vbo);
+            return;
+        }
+        base[i] = ring_put(GL_ARRAY_BUFFER, &s_vs_voff, NVGL_VS_VB_BYTES, 16, data[i], bytes);
+    }
+    /* A wrap above discarded what was uploaded before it: put all of this
+     * draw's streams after one another again if that happened. */
+    for (i = 1; i < 5; i++) {
+        uint32_t j;
+        for (j = 0; j < i; j++)
+            if (L->stride[i] && L->stride[j] && base[i] < base[j]) {
+                uint32_t k;
+                p_glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)NVGL_VS_VB_BYTES, NULL, GL_STREAM_DRAW);
+                s_vs_voff = 0;
+                for (k = 0; k < 5; k++)
+                    if (L->stride[k] && data[k])
+                        base[k] = ring_put(GL_ARRAY_BUFFER, &s_vs_voff, NVGL_VS_VB_BYTES, 16,
+                                           data[k], (size_t)nverts * L->stride[k]);
+                i = 5;
+                break;
+            }
+    }
+    for (i = 0; i < 16; i++) {
+        const NvGlVshInput *in = &L->in[i];
+        const GLvoid *ptr;
+        GLsizei stride;
+        if (!in->used)
+            continue;
+        want |= 1u << i;
+        stride = (GLsizei)L->stride[in->stream];
+        ptr = (const GLvoid *)(uintptr_t)(base[in->stream] + in->offset);
+        switch (in->type) {
+        case 0:    p_glVertexAttribPointer(i, GL_BGRA, GL_UNSIGNED_BYTE, 1, stride, ptr); break;
+        case 1:
+        case 5:    p_glVertexAttribPointer(i, in->size, GL_SHORT, 0, stride, ptr); break;
+        case 2:    p_glVertexAttribPointer(i, in->size, GL_FLOAT, 0, stride, ptr); break;
+        case 4:    p_glVertexAttribPointer(i, in->size, GL_UNSIGNED_BYTE, 1, stride, ptr); break;
+        case 6:    p_glVertexAttribIPointer(i, 1, GL_UNSIGNED_INT, stride, ptr); break;
+        default:   p_glVertexAttribPointer(i, 4, GL_FLOAT, 0, stride, ptr); break;
+        }
+    }
+    want |= 1u << L->cb_loc;
+    p_glVertexAttribPointer((GLuint)L->cb_loc, 1, GL_FLOAT, 0, (GLsizei)L->stride[4],
+                           (const GLvoid *)(uintptr_t)base[4]);
+    for (i = 0; i < 16; i++) {
+        if ((want ^ s_vs_enabled) >> i & 1) {
+            if (want >> i & 1) p_glEnableVertexAttribArray(i);
+            else p_glDisableVertexAttribArray(i);
+        }
+    }
+    s_vs_enabled = want;
+    p_glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, s_vs_ibo);
+    at = ring_put(GL_ELEMENT_ARRAY_BUFFER, &s_vs_ioff, NVGL_VS_IB_BYTES, 4, idx, (size_t)nidx * 4);
+    p_glEnable(GL_CLIP_DISTANCE0);
+    p_glEnable(GL_CLIP_DISTANCE0 + 1);
+    p_glDrawElements(GL_TRIANGLES, (GLsizei)nidx, GL_UNSIGNED_INT, (const GLvoid *)(uintptr_t)at);
+    p_glDisable(GL_CLIP_DISTANCE0);
+    p_glDisable(GL_CLIP_DISTANCE0 + 1);
+    p_glBindVertexArray(s_vao);
+    p_glBindBuffer(GL_ARRAY_BUFFER, s_vbo);
+    if (rs->color_mask & 0x01010101u)
+        s->dirty = 1;
+    s_stat.draws++;
+    s_stat.tris += nidx / 3;
+    s_stat.vsh_draws++;
+    if (s_verbose) {
+        GLenum e = p_glGetError();
+        if (e != GL_NO_ERROR)
+            fprintf(stderr, "[GPU-GL] GL error 0x%X after a vertex-program draw\n", e);
+    }
+}
