@@ -0,0 +1,15 @@
+/* nv2a_movie.h - a movie file decoded for the GL presenter (see nv2a_movie.c). */
+#ifndef NV2A_MOVIE_H
+#define NV2A_MOVIE_H
+
+#include <stdint.h>
+
+/* Open a file and start its sound (paused until the first frame); its
+ * frame size in *w, *h. 0, or -1 when it cannot be played. */
+int  nvmovie_open(const char *path, int *w, int *h);
+/* 1: a new frame is due, BGRA top-down in *bgra (valid until the next
+ * call); 0: none yet; -1: the movie has ended. */
+int  nvmovie_next(const uint8_t **bgra);
+void nvmovie_close(void);
+
+#endif
