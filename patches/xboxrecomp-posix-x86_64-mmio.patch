+static void *gl_proc(const char *name)
+{
+    return SDL_GL_GetProcAddress(name);
+}
+
+static int gl_context_create(void)
+{
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO) != 0) {
+        fprintf(stderr, "[GPU-GL] SDL video: %s\n", SDL_GetError());
+        return 0;
+    }
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE);
+    s_win = SDL_CreateWindow("nv2a", 0, 0, 16, 16,
+                             SDL_WINDOW_OPENGL | SDL_WINDOW_HIDDEN);
+    if (!s_win) {
+        fprintf(stderr, "[GPU-GL] window: %s\n", SDL_GetError());
+        return 0;
+    }
+    s_glctx = SDL_GL_CreateContext(s_win);
+    if (!s_glctx) {
+        fprintf(stderr, "[GPU-GL] context: %s\n", SDL_GetError());
+        return 0;
+    }
+    SDL_GL_MakeCurrent(s_win, s_glctx);
+    return 1;
+}
