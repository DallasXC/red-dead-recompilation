+/* ---- Shared objects -------------------------------------------------- */
+
+static GLuint s_vao, s_vbo, s_white2d, s_whitecube;
+#define NVGL_VB_BYTES ((size_t)16 << 20)
+static size_t s_vb_off;
+static GLuint s_vs;
+static void (*s_write_hook)(uint32_t lo, uint32_t hi);
+static uint32_t s_frame;
+
