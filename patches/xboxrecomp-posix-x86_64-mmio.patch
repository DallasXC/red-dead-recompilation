+        gs(g, "%sC(%d)", neg, (int)o->ci < NV2A_VSH_CONSTANTS ? (int)o->ci : 0);
+    }
+    gs(g, ".%c%c%c%c", sw[o->sw[0]], sw[o->sw[1]], sw[o->sw[2]], sw[o->sw[3]]);
+}
+
+static void glsl_mask(GStr *g, const char *dst, const char *src, uint32_t mask)
+{
+    char m[5];
+    int n = 0;
+    if (mask & 8) m[n++] = 'x';
+    if (mask & 4) m[n++] = 'y';
+    if (mask & 2) m[n++] = 'z';
+    if (mask & 1) m[n++] = 'w';
+    m[n] = 0;
+    if (n)
+        gs(g, "    %s.%s = %s.%s;\n", dst, m, src, m);
+}
+
+char *nv2a_vsh_glsl(void)
+{
+    GStr g = {NULL, 0, 0};
+    uint32_t s;
+    static const char *const outn[13] = {
+        "oPos", NULL, NULL, "oD0", "oD1", "oFog", NULL, NULL, NULL,
+        "oT0", "oT1", "oT2", "oT3"
+    };
+    if (!nv2a_vsh_gpu_ok())
+        return NULL;
+    gs(&g, "  vec4 R[12];\n  for (int i = 0; i < 12; i++) R[i] = vec4(0.0);\n");
+    gs(&g, "  int a0 = 0;\n  vec4 A, B, Cc, M, I;\n");
+    for (s = 0; s < s_dec_n; s++) {
+        const VshIns *d = &s_dec[s];
+        gs(&g, "  { /* %u */\n", s);
+        gs(&g, "    A = "); glsl_src(&g, &d->src[0]); gs(&g, ";\n");
+        gs(&g, "    B = "); glsl_src(&g, &d->src[1]); gs(&g, ";\n");
+        gs(&g, "    Cc = "); glsl_src(&g, &d->src[2]); gs(&g, ";\n");
+        gs(&g, "    M = vec4(0.0); I = vec4(0.0);\n");
+        switch (d->mac) {
+        case 0: break;
+        case 1: gs(&g, "    M = A;\n"); break;
+        case 2: gs(&g, "    M = A * B;\n"); break;
+        case 3: gs(&g, "    M = A + Cc;\n"); break;
+        case 4: gs(&g, "    M = A * B + Cc;\n"); break;
+        case 5: gs(&g, "    M = vec4(A.x*B.x + A.y*B.y + A.z*B.z);\n"); break;
+        case 6: gs(&g, "    M = vec4(A.x*B.x + A.y*B.y + A.z*B.z + B.w);\n"); break;
+        case 7: gs(&g, "    M = vec4(A.x*B.x + A.y*B.y + A.z*B.z + A.w*B.w);\n"); break;
+        case 8: gs(&g, "    M = vec4(1.0, A.y * B.y, A.z, B.w);\n"); break;
+        case 9: gs(&g, "    M = vmin(A, B);\n"); break;
+        case 10: gs(&g, "    M = vmax(A, B);\n"); break;
+        case 11: gs(&g, "    M = vslt(A, B);\n"); break;
+        case 12: gs(&g, "    M = vsge(A, B);\n"); break;
+        case 13: gs(&g, "    M = A;\n"); break;
+        default: gs(&g, "    M = A;\n"); break;
+        }
+        switch (d->ilu) {
+        case 0: break;
+        case 1: gs(&g, "    I = Cc;\n"); break;
+        case 2: gs(&g, "    I = vec4(Cc.x == 0.0 ? uintBitsToFloat(0x7F800000u) : 1.0 / Cc.x);\n"); break;
+        case 3: gs(&g, "    I = vec4(rcc(Cc.x));\n"); break;
+        case 4: gs(&g, "    I = vec4(inversesqrt(abs(Cc.x)));\n"); break;
+        case 5: gs(&g, "    I = iexp(Cc.x);\n"); break;
+        case 6: gs(&g, "    I = ilog(Cc.x);\n"); break;
+        case 7: gs(&g, "    I = ilit(Cc);\n"); break;
+        default: break;
+        }
+        /* MAC temp write (arl writes a0 only), then the ILU's, then o[] --
+         * all from the values read above. */
+        if (d->mac == 13)
+            gs(&g, "    a0 = int(floor(A.x + 0.001));\n");
+        if (d->mac && d->mac != 13 && d->mac_mask) {
+            if (d->tdst == 12)
+                glsl_mask(&g, "oPos", "M", d->mac_mask);
+            else if (d->tdst < 12) {
+                char r[8];
+                snprintf(r, sizeof r, "R[%u]", d->tdst);
+                glsl_mask(&g, r, "M", d->mac_mask);
+            }
+        }
+        if (d->ilu && d->ilu_mask) {
+            uint32_t it = d->mac ? 1u : d->tdst;
+            if (it == 12)
+                glsl_mask(&g, "oPos", "I", d->ilu_mask);
+            else if (it < 12) {
+                char r[8];
+                snprintf(r, sizeof r, "R[%u]", it);
+                glsl_mask(&g, r, "I", d->ilu_mask);
+            }
+        }
+        if (d->omask && !d->out_c && d->oaddr < 13 && outn[d->oaddr])
+            glsl_mask(&g, outn[d->oaddr], d->out_ilu ? "I" : "M", d->omask);
+        gs(&g, "  }\n");
+        if (d->final)
+            break;
+    }
+    return g.p;
+}
