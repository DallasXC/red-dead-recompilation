+uint64_t nv2a_vsh_program_id(void)
+{
+    static uint32_t gen;
+    static uint64_t id;
+    uint32_t s, k;
+    if (gen == s_prog_gen && id)
+        return id;
+    if (!nv2a_vsh_prepare())
+        return 0;
+    id = 14695981039346656037ull;
+    for (s = 0; s < s_dec_n; s++) {
+        const uint8_t *b = (const uint8_t *)&s_dec[s];
+        for (k = 0; k < sizeof s_dec[s]; k++)
+            id = (id ^ b[k]) * 1099511628211ull;
+    }
+    id ^= s_dec_n;
+    if (!id)
+        id = 1;
+    gen = s_prog_gen;
+    return id;
+}
